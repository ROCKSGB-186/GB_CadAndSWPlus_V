<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <!-- SolidWorks 2022 为 64 位进程；固定使用 x64/net472。 -->
    <!-- 禁止 XCad 在每次 Build 后自动执行 RegAsm，避免重复生成旧的 COM 注册项。 -->
    <XCadRegDll>false</XCadRegDll>
    <XCadRegTlb>false</XCadRegTlb>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RootNamespace>GB_CadAndSWPlus_V.SolidWorksAddIn</RootNamespace>
    <AssemblyName>GB_CadAndSWPlus_V_SolidWorksAddIn</AssemblyName>
    <!-- 程序集版本统一由本项目文件管理，避免与 AssemblyInfo.cs 中的版本重复。 -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RegisterForComInterop>false</RegisterForComInterop>
    <ComVisible>true</ComVisible>
    <AssemblyVersion>3.26.1004.169</AssemblyVersion>
    <FileVersion>3.26.1004.169</FileVersion>
    <Version>3.26.1004.169</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>D:\Program Files\SolidWorkS2022\SOLIDWORKS\api\redist\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>D:\Program Files\SolidWorkS2022\SOLIDWORKS\api\redist\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>D:\Program Files\SolidWorkS2022\SOLIDWORKS\api\redist\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Net.Http" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GB_CadAndSWPlus_V_Shared\GB_CadAndSWPlus_V_Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="DisplayPages\Icons\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与 CAD 客户端使用同一套 JSON 序列化库，统一处理服务端 ISO 8601 日期。 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Xarial.XCad" Version="0.8.3" />
    <PackageReference Include="Xarial.XCad.SolidWorks" Version="0.8.3" />
    <PackageReference Include="Xarial.XCad.Toolkit" Version="0.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.resx</DependentUpon>
    </Compile>
    <Compile Update="DisplayPages\SolidWorksAdministrationView.xaml.cs">
      <DependentUpon>SolidWorksAdministrationView.xaml</DependentUpon>
    </Compile>
    <Page Update="DisplayPages\SolidWorksAdministrationView.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resource.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    每次成功生成后只注册当前 TargetPath，不执行 /unregister。
    这样 SolidWorks 始终使用最新 DLL，同时不会删除或重建其它插件的注册信息。
    HKLM 注册需要 Visual Studio 以管理员权限运行。
  -->
  <Target Name="RegisterSolidWorksAddIn" AfterTargets="AfterBuild">
    <PropertyGroup>
      <RegAsmTool>$(windir)\Microsoft.NET\Framework64\v4.0.30319\RegAsm.exe</RegAsmTool>
    </PropertyGroup>

    <Message Importance="High" Text="Registering current SolidWorks AddIn DLL: $(TargetPath)" />
    <Exec Command="&quot;$(RegAsmTool)&quot; &quot;$(TargetPath)&quot; /codebase"
          Condition="Exists('$(TargetPath)')" />
  </Target>
</Project>
