<Window
    x:Class="GB_CadAndSWPlus_V.SolidWorksAddIn.DisplayPages.SW_LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="760"
    Height="540"
    MinWidth="760"
    MinHeight="540"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Background="#F4F7FB"
    FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <!-- SolidWorks 与 CAD 登录页使用同一套自包含样式，避免跨项目引用。 -->
        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0,42,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1677C8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Foreground" Value="#526274" />
            <Setter Property="Background" Value="#EEF2F6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="White" BorderBrush="#DCE5EF" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 品牌区：CAD 与 SolidWorks 使用同一套工程平台账号。 -->
            <Border Grid.Column="0" CornerRadius="8,0,0,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0B4F88" Offset="0" />
                        <GradientStop Color="#1677C8" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42">
                            <Image Source="/GB_CadAndSWPlus_V_SolidWorksAddIn;component/DisplayPages/Icons/沈阳铝镁院LOGO_NEW.png"
                                   Width="42"
                                   Height="42"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="12,1,0,0">
                            <TextBlock Foreground="White" FontSize="19" FontWeight="Bold"><Run Language="zh-cn" Text="沈阳铝镁研究院" /></TextBlock>
                            <TextBlock Text="统一账号中心" Foreground="#D6ECFF" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="欢迎回来" Foreground="White" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="一次登录，连接 CAD 与 SolidWorks" Foreground="#E2F2FF" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <Border Height="1" Background="#55FFFFFF" Margin="0,22,0,20" />
                        <TextBlock Text="统一访问工程数据、图元属性和三维模型服务。" Foreground="#D6ECFF" FontSize="12" TextWrapping="Wrap" LineHeight="22" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="CAD  ·  SolidWorks  ·  工程协同" Foreground="#BFE3FF" FontSize="11" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="30,24,30,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="登录工程平台" Foreground="#1F2D3D" FontSize="22" FontWeight="Bold" />
                <TextBlock Grid.Row="1" Text="使用统一账号访问 SolidWorks 三维协同平台" Foreground="#8090A2" FontSize="12" Margin="0,6,0,22" />

                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="服务器地址" Foreground="#526274" FontSize="12" Margin="0,0,0,6" />
                        <TextBox x:Name="ServerHostTextBox" Style="{StaticResource LoginTextBoxStyle}" ToolTip="请输入服务器 IP 或主机名" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="API 端口" Foreground="#526274" FontSize="12" Margin="0,0,0,6" />
                        <TextBox x:Name="ApiPortTextBox" Style="{StaticResource LoginTextBoxStyle}" ToolTip="默认端口：10010" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,0,0,14">
                    <TextBlock Text="用户名" Foreground="#526274" FontSize="12" Margin="0,0,0,6" />
                    <TextBox x:Name="UsernameTextBox" Style="{StaticResource LoginTextBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,0,0,16">
                    <TextBlock Text="密码" Foreground="#526274" FontSize="12" Margin="0,0,0,6" />
                    <Grid Height="36">
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource LoginPasswordBoxStyle}" />
                        <TextBox x:Name="PasswordVisibleTextBox" Style="{StaticResource LoginTextBoxStyle}" Padding="12,0,42,0" Visibility="Collapsed" />
                        <Button x:Name="TogglePasswordButton"
                                Width="38"
                                Height="34"
                                Margin="0,1,1,1"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="TogglePassword_Click"
                                Content="👁"
                                FontFamily="Segoe UI Symbol"
                                FontSize="15"
                                Foreground="#6B7C8F"
                                ToolTip="显示密码" />
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="5" x:Name="StatusTextBlock" Foreground="#526274" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top" />

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="取消" Width="86" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" />
                    <Button Content="登录" Width="106" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Login_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>