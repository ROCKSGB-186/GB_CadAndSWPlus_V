                FontSize="14"
                FontWeight="Bold" Margin="0,0,0,0" Width="80" >
                <Grid x:Name="分类与图元操作功能区" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="170" />
                        <RowDefinition Height="35" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="195" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="0.5*" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>
                    <!-- 第二行原有分类操作按钮已移至 SolidWorks 分类树右键菜单。 -->
                    <Grid x:Name="SW预览窗口" Grid.Row="0">
                        <!-- 图片与三维模型放在同一个预览窗口中，左侧显示图片，右侧显示三维模型。 -->
                        <Border x:Name="SW_3D预览" Height="170" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Top" BorderBrush="Gray" BorderThickness="1" Background="Black">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="White" BorderBrush="Gray" BorderThickness="0,0,1,0">
                                    <Image x:Name="SW_资源ViewImage" Width="170" Height="170" Stretch="Uniform" />
                                </Border>
                                <wv2:WebView2 x:Name="SW_资源ThreeDPreviewHost" Grid.Column="1" />
                            </Grid>
                        </Border>
                    </Grid>
                    <!--  第一行  -->
                    <Grid x:Name="主分类按键区" Grid.Row="1"  Background="FloralWhite">
                        <Button x:Name="SW_加载分类数据库"
                            Width="130"
                            Height="25"
                            MaxWidth="200"
                            MaxHeight="50"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,6"
                            Click="SW_LoadCategoryDatabase_Btn_Click"
                            Content="加载数据库分类"
                            FontSize="15 " />
                    </Grid>
                    <!--  第三行，管理员模块中的Grid.Row="2"  -->
                    <Grid x:Name="SW_CategoryDisplayGrid"  Grid.Row="2"
                        Background="FloralWhite">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <!--  修改架构树的TreeView，添加右键菜单  -->
                        <TreeView x:Name="SW_CategoryTreeView"  Grid.Column="0"
                            MinWidth="100"
                            MaxWidth="300"
                            Margin="0,0,-3,0"
                             SelectedItemChanged="SW_CategoryTreeView_SelectedItemChanged">
                            <!-- SolidWorks 分类树专用右键菜单，不复用 CAD 规范树菜单。 -->
                            <TreeView.ContextMenu>
                                <ContextMenu Opened="SW_CategoryContextMenu_Opened">
                                    <MenuItem Header="添加主分类" Click="SW_NewCategory_MenuItem_Click" />
                                    <MenuItem Header="添加子分类" Click="SW_AddSubcategory_MenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="修改分类" Click="SW_Edit_MenuItem_Click" />
                                    <MenuItem Header="删除分类" Click="SW_Delete_MenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="展开\折叠架构" Click="SW_展开_折叠架构_Click" />
                                    <MenuItem Header="刷新架构树" Click="SW_刷新架构树按钮_Click" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}" />
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <HierarchicalDataTemplate.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        </Style>
                                    </HierarchicalDataTemplate.ItemContainerStyle>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        Text="{Binding DisplayText}"
                                        TextWrapping="NoWrap" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <!--  分割线  -->
                        <GridSplitter x:Name="分割线" Grid.Column="1"
                            Width="5"
                            HorizontalAlignment="Stretch"
                            Background="LightGray" />
                        <!--  右侧：文件列表  -->
                        <!--  第五行 当前分类下所选统一构件的 SolidWorks 资源管理区。 -->
                        <DataGrid x:Name="SW_StroageFileDataGrid"
                                  Grid.Column="2 " Margin="0"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  GridLinesVisibility="All" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="SW_StroageFileDataGrid_SelectionChanged"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" FontSize="12">
                            <DataGrid.Resources>
                                <ContextMenu x:Key="SW_ResourceRowContextMenu">
                                    <MenuItem Header="刷新" Click="SW_AdminRefreshResources_Click" />
                                    <Separator />
                                    <MenuItem Header="更新模型" Click="SW_AdminUpdateModel_Click" />
                                    <MenuItem Header="替换预览图" Click="SW_AdminReplacePreviewImage_Click" />
                                    <MenuItem Header="上传/替换3D预览" Click="SW_AdminReplacePreview3D_Click" />
                                    <MenuItem Header="预览图片" Click="SW_AdminPreviewImage_Click" />
                                    <MenuItem Header="预览3D" Click="SW_AdminPreview3D_Click" />
                                    <Separator />
                                    <MenuItem Header="归档资源" Click="SW_AdminArchiveResource_Click" />
                                    <MenuItem Header="删除图元" Click="SW_DeleteGraphic_Btn_Click" />
                                </ContextMenu>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="SW_StroageFileDataGridRow_PreviewMouseRightButtonDown" />
                                    <Setter Property="ContextMenu" Value="{StaticResource SW_ResourceRowContextMenu}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="资源名称" Binding="{Binding ResourceName}" Width="100" />
                                <DataGridTextColumn Header="类型" Binding="{Binding ResourceType}" Width="90" />
                                <DataGridTextColumn Header="配置" Binding="{Binding ConfigurationName}" Width="100" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" />
                                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="55" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <!--  第四行  -->
                    <Grid x:Name="添加图元功能区" Grid.Row="3" 
                        Background="Azure">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="155" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <!-- 先选择分类下的统一构件，再执行模型和预览文件操作。 -->
                            <TextBlock Text="统一构件："
                                 Margin="13,7,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 FontSize="15"
                                 Panel.ZIndex="20" />
                            <ComboBox x:Name="SW_ElementSelectionComboBox"
                                 Width="245"
                                 Height="22"
                                 Margin="91,6,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Background="White"
                                 Panel.ZIndex="20"
                                 DisplayMemberPath="DisplayText"
                                 SelectionChanged="SW_ElementSelectionComboBox_SelectionChanged" />
                            <Button x:Name="选择图元文件" Content="选择图元文件"
                                 Width="86"
                                 Height="20"
                                 Click="SW_SelectFile_Btn_Click"
                                 FontSize="13" Margin="2,31,256,100" Padding="1,1,1,0" Grid.IsSharedSizeScope="True">
                            </Button>
                            <TextBox x:Name="SW_filePath"
                                 Height="22"
                                 Margin="91,31,8,0"
                                 AcceptsTab="True"
                                 BorderThickness="1,1,1,1"
                                 FontSize="8"
                                 SelectionOpacity="0.5"
                                 Style="{StaticResource WatermarkTextBoxStyle}"
                                 Tag="文件路径："
                                 TextWrapping="Wrap" VerticalAlignment="Top" />
                            <Button x:Name="选择预览图" Content="选择预览图" 
                                 Width="86"
                                 Height="20"
                                 Margin="2,55,256,76"
                                 Click="SelectViewImage_Btn_Click"
                                 FontSize="14" />
                            <TextBox x:Name="SW_viewFilePath"
                                 Height="22"
                                 Margin="91,55,8,0"
                                 VerticalAlignment="Top"
                                 AcceptsTab="True"
                                 BorderThickness="1,2,1,1"
                                 FontSize="8"
                                 SelectionOpacity="0.5"
                                 Style="{StaticResource WatermarkTextBoxStyle}"
                                 Tag="预览图文件路径："
                                 TextWrapping="Wrap" />
                            <TextBox x:Name="SW_FileName"
                                 Height="22"
                                 Margin="91,79,8,0"
                                 VerticalAlignment="Top"
                                 AcceptsTab="True"
                                 BorderThickness="1,2,1,1"
                                 FontSize="10"
                                 SelectionOpacity="0.5"
                                 Style="{StaticResource WatermarkTextBoxStyle}"
                                 Tag="文件名称："
                                 TextWrapping="Wrap" />
                            <TextBox x:Name="SW_FileSize"
                                 Height="22"
                                 Margin="91,103,8,0"
                                 VerticalAlignment="Top"
                                 IsReadOnly="True"
                                 BorderThickness="1,2,1,1"
                                 FontSize="10"
                                 SelectionOpacity="0.5"
                                 Style="{StaticResource WatermarkTextBoxStyle}"
                                 Tag="文件类型："
                                 TextWrapping="Wrap" />
                            <TextBox x:Name="SW_ClientVersion"
                                 Height="22"
                                 Margin="91,127,8,0"
                                 VerticalAlignment="Top"
                                 BorderThickness="1,2,1,1"
                                 FontSize="10"
                                 SelectionOpacity="0.5"
                                 Style="{StaticResource WatermarkTextBoxStyle}"
                                  Tag="SolidWorks配置名/版本："
                                 TextWrapping="Wrap" />
                            <Button x:Name="SW_ImportFromSelectionBtn"
                                Width="86"
                                Height="20"
                                Margin="2,0,0,54"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Click="SW_ImportFromSelection_Btn_Click"
                                Content="添加当前图形入库"
                                FontSize="10" RenderTransformOrigin="0.5,0.5" >
                                <Button.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="0.049"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Button.RenderTransform>
                            </Button>
                            <TextBlock x:Name="文件类型" Text="文件类型："
                                Margin="29,107,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                FontSize="13"
                                Panel.ZIndex="20" FontWeight="Normal" />
                            <TextBlock x:Name="配置名与版本" Text="配置名/版本："
                                Margin="10,131,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                FontSize="13"
                                Panel.ZIndex="20" FontWeight="Normal" />

                        </Grid>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,0">
                            <Button  Content="完成添加" x:Name="SW_AddFileBtn"  Width="86" Height="30"  Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Click="SW_AddFile_Btn_Click"  FontSize="14" Foreground="White" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Button Content="刷新" Click="SW_AdminRefreshResources_Click" Height="20" Width="65" />
                            <Button Content="还原初始值" x:Name="SW_ResetToInitialBtn" Margin="1,1,1,1"  Width="65" Height="20" Click="SW_ResetToInitial_Btn_Click"/>
                            <Button Content="应用属性"  x:Name="SW_ApplyPropertiesBtn" Margin="1,1,1,1"  Width="65" Height="20" Click="SW_ApplyProperties_Btn_Click" />
                        </WrapPanel>

                    </Grid>

                    <!--  第六行 图元属性表  -->
                    <Grid x:Name="图元属性表" Grid.Row="4">
                        <ScrollViewer Margin="0,0,0,0" VerticalScrollBarVisibility="Auto">
                            <!--  属性编辑DataGrid  -->
                            <DataGrid x:Name="SW_CategoryPropertiesDataGrid"
                                Margin="0"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                FontSize="11"
                                GridLinesVisibility="All"
                                HeadersVisibility="Column" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="90" Header="属性编码" Binding="{Binding PropertyCode}" IsReadOnly="True" />
                                    <DataGridTextColumn Width="130" Header="属性名称" Binding="{Binding PropertyName}" IsReadOnly="True" />
                                    <DataGridTextColumn Width="70" Header="类型" Binding="{Binding DataType}" IsReadOnly="True" />
                                    <DataGridTextColumn Width="60" Header="单位" Binding="{Binding Unit}" IsReadOnly="True" />
                                    <DataGridTemplateColumn Width="*" Header="属性值">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ValueText}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox
                                                    InputMethod.IsInputMethodEnabled="True"
                                                    Language="zh-CN"
                                                    Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </Grid>
                    <!-- 管理员模块专用状态栏；原 TxtStatus 位于部门/人员模块，管理员页面无法看到查询结果。 -->
                    <Border Grid.Row="5"
                            Height="Auto"
                            Margin="1,0,1,1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Background="#FFF7F9FC"
                            Panel.ZIndex="10">
                        <TextBlock x:Name="SW_AdminStatusText"
                                   Margin="0"
                                   Foreground="Gray"
                                   Text="{Binding Text, ElementName=TxtStatus}"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </TabItem>
            <!--  第四TabControlItem(部门_人员模块)  -->
            <TabItem x:Name="SW_DepartmentUsersModuleTab"
                Width="105"
                Header="部门\人员模块"
                FontSize="14"
                FontWeight="Bold"
                     Margin="0,0,0,0"  >
                <Grid x:Name="SW_部门_人员模块_Grid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="1.5*" />
                    </Grid.RowDefinitions>

                    <Grid Name="SW_部门管理页面"
                        Grid.Column="0"
                        Margin="0"
                        Background="#FFECECEC">
                        <!-- 部门表格使用 * 行，随模块高度自动填充 -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SW_部门管理"
                            Grid.Row="0"
                            Margin="0,5,0,5"
                            Background="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                            FontSize="15"
                            FontWeight="Bold"
                            Text=" 部门管理" />
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,0,0,3"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">
                            <Button
                                x:Name="SW_BtnSync"
                                Width="90"
                                Margin="0,0,3,0"
                                Click="SW_BtnSync_Click"
                                Content="获取部门" />
                            <Button
                                x:Name="SW_BtnAddDept"
                                Width="80"
                                Margin="0,0,3,0"
                                Click="SW_BtnAddDept_Click"
                                Content="新增部门" />
                            <Button
                                x:Name="SW_BtnEditDept"
                                Width="80"
                                Margin="0,0,3,0"
                                Click="SW_BtnEditDept_Click"
                                Content="编辑部门" />
                            <Button
                                x:Name="SW_BtnDeleteDept"
                                Width="80"
                                Click="SW_BtnDeleteDept_Click"
                                Content="删除部门" />
                        </StackPanel>
                        <DataGrid
                            x:Name="SW_DepartmentsGrid"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            SelectionChanged="DepartmentsGrid_SelectionChanged"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="35"
                                    Binding="{Binding Id}"
                                    Header="ID" />
                                <DataGridTextColumn
                                    Width="95"
                                    Binding="{Binding Name}"
                                    Header="名称" />
                                <DataGridTextColumn
                                    Width="95"
                                    Binding="{Binding DisplayName}"
                                    Header="显示名" />
                                <DataGridTextColumn
                                    Width="38"
                                    Binding="{Binding UserCount}"
                                    Header="数量" />
                                <DataGridTextColumn
                                    Width="38"
                                    Binding="{Binding SortOrder}"
                                    Header="排序" />
                                <DataGridCheckBoxColumn
                                    Width="35"
                                    Binding="{Binding IsActive}"
                                    Header="启用" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid x:Name="SW_部门用户_分配_Grid" 
                        Grid.Row="2"
                        Margin="0"
                        Background="#FFECECEC">
                        <!-- 用户表格使用 * 行，随模块高度自动填充 -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SW_部门用户_分配"
                            Grid.Row="0"
                            Margin="0,5,0,5"
                            Background="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                            FontSize="14"
                            FontWeight="Bold"
                            Text=" 部门用户 / 分配" />
                        <StackPanel x:Name="SW_部门用户_分配_StackPanel"
                            Grid.Row="1"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">
                            <Button
                                x:Name="SW_BtnRefresh"
                                Width="80"
                                Height="25"
                                Margin="1,1,5,1"
                                Click="SW_BtnRefresh_Click"
                                Content="刷新" />
                            <Button
                                x:Name="SW_BtnAddUserManaged"
                                Width="80"
                                Height="25"
                                Margin="1,1,5,1"
                                HorizontalContentAlignment="Left"
                                Click="SW_BtnAddUserManaged_Click"
                                Content="增加人员" />
                            <Button
                                x:Name="SW_BtnEditUserManaged"
                                Width="80"
                                Height="25"
                                Margin="1,1,5,1"
                                Click="SW_BtnEditUserManaged_Click"
                                Content="编辑人员" />
                            <Button
                                x:Name="SW_BtnDeleteUserManaged"
                                Width="80"
                                Height="25"
                                Margin="1,1,0,1"
                                Click="SW_BtnDeleteUserManaged_Click"
                                Content="删除人员" />
                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            Margin="0,3,0,3"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                            <TextBox
                                x:Name="SW_TxtSearchUser"
                                Width="180"
                                Margin="5,0,5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontWeight="Normal"
                                 Text="输入用户名搜索/分配"
                                 TextChanged="SW_TxtSearchUser_TextChanged" />
                            <Button
                                x:Name="SW_BtnAssignUser"
                                Width="150"
                                Height="20"
                                Margin="2,1,1,1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Click="SW_BtnAssignUser_Click"
                                Content="将用户分配到选中部门" />
                        </StackPanel>

                        <DataGrid
                            x:Name="SW_UsersGrid"
                            Grid.Row="3"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="40"
                                    Binding="{Binding Id}"
                                    Header="ID" />
                                <DataGridTextColumn
                                    Width="85"
                                    Binding="{Binding Username}"
                                    Header="用户名" />
                                <DataGridTextColumn
                                    Width="85"
                                     Binding="{Binding RealName}"
                                    Header="姓名" />
                                <DataGridTextColumn
                                    Width="123"
                                    Binding="{Binding Phone}"
                                    Header="电话" />
                            </DataGrid.Columns>
                        </DataGrid>


                    </Grid>

                    <StackPanel
                        Grid.Row="2"
                        Width="154"
                        Height="22"
                        Margin="10,0,0,58"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom" />

                    <StackPanel
                        Grid.Row="2"
                        Height="50"
                        VerticalAlignment="Bottom">
                        <TextBlock
                            x:Name="TxtStatus"
                            Height="45"
                            Margin="0,0,0,0"
                            Foreground="Gray"
                            TextWrapping="Wrap" />
                    </StackPanel>

                </Grid>
            </TabItem>
        </TabControl>

        <!-- 未登录时不显示任何业务图元，只显示统一登录入口。 -->
        <Grid x:Name="LoginRequiredOverlay"
              Panel.ZIndex="100"
              Background="#FFF7F9FC"
              d:Visibility="Collapsed"
              Visibility="Visible">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="280">
                <TextBlock Text="请《登录》
                           CAD与SOLIDWORKS
                           数据互通平台"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#24527A"
                           Margin="10" />
                <Button x:Name="OpenLoginButton"
                        Content="点击登录"
                        Click="OpenLoginButton_Click"
                        HorizontalAlignment="Center"
                        Padding="22,8"
                        Margin="12"
                        Foreground="#0563C1"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="16"
                        Cursor="Hand" />
                <TextBlock Text="登录后将加载统一部门、用户和图元数据。"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#666666"
                           Margin="10,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
