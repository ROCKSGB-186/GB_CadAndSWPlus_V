                        <TabItem x:Name="暖通"
                                Height="50"
                                VerticalAlignment="Bottom"
                                FontWeight="Bold"
                                Header="暖通">
                            <TabControl>
                                <TabItem x:Name="暖通图元" Header=" 图元集 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
