                                        </Grid>
                                        <ScrollViewer
                                                Grid.Row="2"
                                                Margin="0"
                                                VerticalScrollBarVisibility="Auto">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1*" />
                                                    <RowDefinition Height="200" />
                                                </Grid.RowDefinitions>
                                                <WrapPanel
                                                                x:Name="HVACButtonsPanel"
                                                                Grid.Row="0"
                                                                Orientation="Vertical">
                                                    <WrapPanel x:Name="SolidWorksHvacDynamicPanel" Orientation="Vertical" />
                                                </WrapPanel>
                                                <Grid Grid.Row="1" />
                                            </Grid>

                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="暖通_条件绘制" Header=" 条件绘制 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Height="Auto"
                                                Margin="0,0,0,0"
                                                FontSize="12"
                                                VerticalScrollBarVisibility="Visible">

                                            <Grid/>
                                        </ScrollViewer>

                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="暖通图层" Header=" 图层管理 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="200" />
                                            <RowDefinition Height="2*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Height="Auto"
                                                Margin="0,0,0,0"
                                                FontSize="12"
                                                VerticalScrollBarVisibility="Visible" />
