<UserControl x:Class="GB_CadAndSWPlus_V.SolidWorksAddIn.DisplayPages.RightResourceLibrary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GB_CadAndSWPlus_V.SolidWorksAddIn.DisplayPages"
             mc:Ignorable="d"
              d:Margin="0"
              d:MaxWidth="350"
              d:MinHeight="800"
              d:MinWidth="350">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MainWindowStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White">
        <TabControl Style="{StaticResource TabControlStyle}">
            <TabItem x:Name="SW资源库" Header="SW资源库" Width="80"
                     FontSize="14"
                     FontWeight="Bold"
                     RenderTransformOrigin="0.5,0.5"
                     Margin="0,0,0,0"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Stretch">
                <Grid x:Name="SW专业图元"
                      Background="White"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="10" />
                    </Grid.RowDefinitions>
                    <TabControl x:Name="MajroTabControl"
                                    Grid.Row="1"
                            Margin="0,0,0,0"
                            Padding="0,2,0,2"
                            Background="Azure"
                            ItemContainerStyle="{StaticResource VerticalTabStyle}"
                            SelectionChanged="TabControl_SelectionChanged"
                            TabStripPlacement="Left">
                        <TabItem x:Name="公用工具"
                                Height="68"
                                FontSize="12"
                                FontWeight="Bold"
                                Header="公用工具">
                            <Grid>
                                <TabControl>
                                    <TabItem x:Name="公用图元"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Header="公用图元">
                                        <WrapPanel x:Name="PublicButtonsPanel" />
                                    </TabItem>

                                    <TabItem x:Name="常用工具"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Header="常用工具">
                                        <Grid/>
                                    </TabItem>

                                    <TabItem x:Name="图层工具"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Header="图层工具">
                                        <TabItem.Background>
                                            <LinearGradientBrush EndPoint="0,1">
                                                <GradientStop Offset="0.596" Color="#FFF0F0F0" />
                                            </LinearGradientBrush>
                                        </TabItem.Background>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="55" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <!-- 图层数据表 Layer Data Grid  -->
                                            <!--  状态信息  -->
                                            <TextBlock
                                                    x:Name="statusText"
                                                    Grid.Row="2"
                                                    Margin="5"
                                                    VerticalAlignment="Center"
                                                    Text="就绪" />
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="工艺"                                
                                     FontWeight="Bold"
                                     Header="工艺"
                                     IsSelected="True">
                            <TabControl
                                    x:Name="MajorTabControl"
                                    Padding="1,1,1,1"
                                    FontSize="12">
                                <TabItem x:Name="工艺图元" Header=" 工艺图元 ">
                                    <ScrollViewer x:Name="图元功能区" 
                                            Margin="0,0,0,0"
                                            FontSize="12"
                                            HorizontalScrollBarVisibility="Auto"
                                            CanContentScroll="False"
                                            VerticalScrollBarVisibility="Auto">
                                        <Grid x:Name="按键功能区" HorizontalAlignment="Left" Width="305">
                                            <Grid >
                                                <Grid Margin="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="85" />
                                                        <RowDefinition Height="60" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <GroupBox
                                                                x:Name="工艺表格"
                                                                Padding="0,3,0,0"
                                                                Header="工艺表格" Margin="0,5,0,0">
                                                            <WrapPanel x:Name="工艺表格按钮面板" Orientation="Horizontal" Height="55">
                                                                <Button x:Name="_1"                                                                         
                                                                            Width="95"
                                                                            Height="25"
                                                                            Margin="1,1,1,1"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Background="#FF0050A0"
                                                                            BorderBrush="#FFC2C6CE"
                                                                            Content="生成管道表"
                                                                            FontSize="12"
                                                                            Foreground="White" />
                                                                <Button x:Name="_2"
                                                                         Width="95"
                                                                         Height="25"
                                                                         Margin="2,1,1,1"
                                                                         HorizontalAlignment="Left"
                                                                         VerticalAlignment="Top"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Content="生成设备表"
                                                                         FontSize="12"
                                                                         Foreground="White" />
                                                                <Button x:Name="_3"
                                                                         Width="95"
                                                                         Height="25"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Content="插入管道表"
                                                                         FontSize="12"
                                                                         Foreground="White" Margin="2,1,1,1" />
                                                                <Button x:Name="_4"
                                                                         Width="95"
                                                                         Height="25"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Top"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Content="导出表格"
                                                                         FontSize="12"
                                                                         Foreground="White" Margin="1,1,1,1" />
                                                                <Button x:Name="_5"
                                                                         Width="95"
                                                                         Height="25"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Content="表格同步"
                                                                         FontSize="12"
                                                                         Foreground="White" Margin="2,1,1,1" />
                                                                <Button x:Name="_6"
                                                                         Width="95"
                                                                         Height="25"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Content="加载Excel表"
                                                                         FontSize="12"
                                                                         Foreground="White" Margin="2,1,1,1" />
                                                            </WrapPanel>
                                                        </GroupBox>
                                                    </Grid>
                                                    <Grid Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="214*" />
                                                        </Grid.ColumnDefinitions>
                                                    </Grid>
                                                    <WrapPanel
                                                            x:Name="CraftButtonsPanel"
                                                            Grid.Row="2"
                                                            Orientation="Vertical" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem x:Name="工艺管道计算" Header="管道计算表" >
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="60" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible"/>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="工艺_条件绘制" Header=" 条件绘制 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Margin="0"
                                                FontSize="10"
                                                VerticalScrollBarVisibility="Auto">
                                            <Grid Width="285" HorizontalAlignment="Left">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <StackPanel x:Name="ConditionsPanel" Orientation="Vertical">
                                                    <!--  工艺专业条件  -->
                                                    <!--  工艺专业标注  -->
                                                    <!--  电气专业条件  -->
                                                    <!--  给排水专业条件  -->
                                                    <!--  自控专业条件  -->
                                                    <!--  建筑专业条件  -->
                                                    <!--  结构专业条件  -->
                                                    <!--  暖通专业条件  -->

                                                </StackPanel>
                                            </Grid>
                                        </ScrollViewer>

                                    </Grid>
                                </TabItem>

                            </TabControl>
                        </TabItem>

                        <TabItem x:Name="建筑"
                                FontWeight="Bold"
                                Header="建筑">
                            <TabControl>
                                <TabItem x:Name="建筑图元" Header=" 图元集 ">
                                    <Grid>
                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="*" />

                                        </Grid.RowDefinitions>

                                        <ScrollViewer
                                                Grid.Row="0"
                                                Margin="0"
                                                VerticalScrollBarVisibility="Auto">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1*" />
                                                    <RowDefinition Height="80" />
                                                </Grid.RowDefinitions>
                                                <WrapPanel
                                                        x:Name="ArchitectureButtonsPanel"
                                                        Grid.Row="0"
                                                        Orientation="Vertical" />
                                                <Grid Grid.Row="1" />

                                            </Grid>

                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="建筑_条件绘制" Header=" 条件绘制 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                                Grid.Row="1"
                                                Height="Auto"
                                                Margin="0,0,0,0"
                                                FontSize="12"
                                                VerticalScrollBarVisibility="Visible" />
                                    </Grid>
                                </TabItem>
                                <TabItem
                                        x:Name="建筑图层"
                                        Height="21"
                                        VerticalAlignment="Top"
                                        Header=" 图层管理">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="300" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" />
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Height="Auto"
                                                Margin="0,0,0,0"
                                                FontSize="12"
                                                VerticalScrollBarVisibility="Visible" />
                                    </Grid>

                                </TabItem>
                            </TabControl>
                        </TabItem>

                        <TabItem x:Name="结构"
                                FontWeight="Bold"
                                Header="结构">
                            <TabControl>
                                <TabItem x:Name="结构图元" Header=" 图元集 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1*" />
                                                    <RowDefinition Height="200" />
                                                </Grid.RowDefinitions>
                                                <WrapPanel
                                                        x:Name="StructureButtonsPanel"
                                                        Grid.Row="0"
                                                        Orientation="Vertical" />
                                                <Grid Grid.Row="1" />
                                            </Grid>



                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="结构_条件绘制" Header=" 条件绘制 ">
                                    <ScrollViewer
                                            Grid.Row="0"
                                            Height="Auto"
                                            Margin="0,0,0,0"
                                            FontSize="12"
                                            VerticalScrollBarVisibility="Visible">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                        </Grid>
                                    </ScrollViewer>

                                </TabItem>
                                <TabItem x:Name="结构图层" Header=" 图层管理 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="200" />
                                            <RowDefinition Height="2*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Height="Auto"
                                                Margin="0,0,0,0"
                                                FontSize="12"
                                                VerticalScrollBarVisibility="Visible" />
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </TabItem>

                        <TabItem x:Name="给排水"
                                FontWeight="Bold"
                                Header="给排水">
                            <TabControl>
                                <TabItem x:Name="给排水图元" Header=" 图元集 ">
                                    <Grid>
                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="2*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Margin="0"
                                                VerticalScrollBarVisibility="Auto">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1*" />
                                                    <RowDefinition Height="200" />
                                                </Grid.RowDefinitions>
                                                <WrapPanel
                                                        x:Name="PlumbingButtonsPanel"
                                                        Grid.Row="0"
                                                        Orientation="Vertical" />
                                                <Grid Grid.Row="1" />
                                            </Grid>

                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="给排水_条件绘制" Header=" 条件绘制 ">
                                    <ScrollViewer
                                            Grid.Row="0"
                                            Height="Auto"
                                            Margin="0,0,0,0"
                                            FontSize="12"
                                            VerticalScrollBarVisibility="Visible">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                        </Grid>
                                    </ScrollViewer>

                                </TabItem>
                                <TabItem x:Name="给排水图层" Header=" 图层管理 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="200" />
                                            <RowDefinition Height="2*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Height="Auto"
                                                Margin="0,0,0,0"
                                                FontSize="12"
                                                VerticalScrollBarVisibility="Visible" />
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </TabItem>

                        <TabItem x:Name="暖通"
                                Height="50"
                                VerticalAlignment="Bottom"
                                FontWeight="Bold"
                                Header="暖通">
                            <TabControl>
                                <TabItem x:Name="暖通图元" Header=" 图元集 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <GroupBox
                                                    x:Name="暖通表格"
                                                    Margin="5"
                                                    Padding="0,3,0,0"
                                                    Header="工艺表格">
                                                <WrapPanel x:Name="暖通表格按钮面板" Orientation="Horizontal">
                                                    <Button
                                                            x:Name="_7"
                                                            Width="85"
                                                            Height="25"
                                                            Margin="1,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Background="#FF0050A0"
                                                            BorderBrush="#FFC2C6CE"
                                                            Content="导出表格"
                                                            FontSize="12"
                                                            Foreground="White" />


                                                </WrapPanel>
                                            </GroupBox>
                                        </Grid>
                                        <ScrollViewer
                                                Grid.Row="2"
                                                Margin="0"
                                                VerticalScrollBarVisibility="Auto">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1*" />
                                                    <RowDefinition Height="200" />
                                                </Grid.RowDefinitions>
                                                <WrapPanel
                                                        x:Name="HVACButtonsPanel"
                                                        Grid.Row="0"
                                                        Orientation="Vertical" />
                                                <Grid Grid.Row="1" />
                                            </Grid>

                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="暖通_条件绘制" Header=" 条件绘制 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Height="Auto"
                                                Margin="0,0,0,0"
                                                FontSize="12"
                                                VerticalScrollBarVisibility="Visible">

                                            <Grid/>
                                        </ScrollViewer>

                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="暖通图层" Header=" 图层管理 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="200" />
                                            <RowDefinition Height="2*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Height="Auto"
                                                Margin="0,0,0,0"
                                                FontSize="12"
                                                VerticalScrollBarVisibility="Visible" />
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </TabItem>

                        <TabItem x:Name="电气"
                                Height="50"
                                VerticalAlignment="Bottom"
                                FontWeight="Bold"
                                Header="电气">
                            <TabControl>
                                <TabItem x:Name="电气图元" Header=" 图元集 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" />
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Margin="0"
                                                VerticalScrollBarVisibility="Auto">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="200" />
                                                </Grid.RowDefinitions>
                                                <WrapPanel
                                                        x:Name="ElectricalButtonsPanel"
                                                        Grid.Row="0"
                                                        Orientation="Vertical" />
                                                <Grid Grid.Row="1" />
                                            </Grid>


                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="电气_条件绘制" Header=" 条件绘制 ">
                                    <ScrollViewer
                                            Grid.Row="0"
                                            Height="Auto"
                                            Margin="0,0,0,0"
                                            FontSize="12"
                                            VerticalScrollBarVisibility="Visible">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                        </Grid>
                                    </ScrollViewer>

                                </TabItem>
                                <TabItem x:Name="电气图层" Header=" 图层管理 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="200" />
                                            <RowDefinition Height="2*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Height="Auto"
                                                Margin="0,0,0,0"
                                                FontSize="12"
                                                VerticalScrollBarVisibility="Visible" />
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </TabItem>

                        <TabItem x:Name="自控"
                                FontWeight="Bold"
                                Header="自控">
                            <TabControl>
                                <TabItem x:Name="自控图元" Header=" 图元集 ">
                                    <Grid>
                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="2*" />
                                        </Grid.RowDefinitions>

                                        <ScrollViewer
                                                Grid.Row="0"
                                                Margin="0"
                                                VerticalScrollBarVisibility="Auto">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="200" />
                                                </Grid.RowDefinitions>
                                                <WrapPanel
                                                        x:Name="ControlButtonsPanel"
                                                        Grid.Row="0"
                                                        Orientation="Vertical" />
                                                <Grid Grid.Row="1" />
                                            </Grid>

                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="自控_条件绘制" Header=" 条件绘制 ">
                                    <ScrollViewer
                                            Grid.Row="0"
                                            Height="Auto"
                                            Margin="0,0,0,0"
                                            FontSize="12"
                                            VerticalScrollBarVisibility="Visible">
                                        <Grid/>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem
                                        x:Name="自控图层"
                                        Height="21"
                                        VerticalAlignment="Top"
                                        Header=" 图层管理 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="200" />
                                            <RowDefinition Height="2*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Height="Auto"
                                                Margin="0,0,0,0"
                                                FontSize="12"
                                                VerticalScrollBarVisibility="Visible" />
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </TabItem>

                        <TabItem x:Name="总图"
                                FontWeight="Bold"
                                Header="总图">
                            <TabControl>
                                <TabItem x:Name="总图图元" Header=" 图元集 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="2*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                                Grid.Row="0"
                                                Margin="5"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="#0078D4"
                                                Text="总图列表" />
                                        <ScrollViewer
                                                Grid.Row="1"
                                                Margin="0"
                                                VerticalScrollBarVisibility="Auto">
                                            <WrapPanel x:Name="GeneralButtonsPanel" Orientation="Vertical" />
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="总图条件绘制" Header=" 条件绘制 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Height="Auto"
                                                Margin="0,0,0,0"
                                                FontSize="12"
                                                VerticalScrollBarVisibility="Visible" />
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="总图图层" Header=" 图层管理 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="2*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Height="Auto"
                                                Margin="0,0,0,0"
                                                FontSize="12"
                                                VerticalScrollBarVisibility="Visible" />
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </TabItem>

                    </TabControl>

                </Grid>

            </TabItem>
            <TabItem Header="设置" Margin="0,0,0,0" Width="80" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Grid Background="White" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
