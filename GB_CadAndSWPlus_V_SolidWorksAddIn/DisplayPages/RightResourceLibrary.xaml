                                        Height="21"
                                        VerticalAlignment="Top"
                                        Header=" 图层管理">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="300" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" />
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Height="Auto"
                                                Margin="0,0,0,0"
                                                FontSize="12"
                                                VerticalScrollBarVisibility="Visible" />
                                    </Grid>

                                </TabItem>
                            </TabControl>
                        </TabItem>

                        <TabItem x:Name="结构"
                                FontWeight="Bold"
                                Header="结构">
                            <TabControl>
                                <TabItem x:Name="结构图元" Header=" 图元集 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1*" />
                                                    <RowDefinition Height="200" />
                                                </Grid.RowDefinitions>
                                                <WrapPanel
                                                        x:Name="StructureButtonsPanel"
