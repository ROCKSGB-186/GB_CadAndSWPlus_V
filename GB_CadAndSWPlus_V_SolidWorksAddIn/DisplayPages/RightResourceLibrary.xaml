<UserControl x:Class="GB_CadAndSWPlus_V.SolidWorksAddIn.DisplayPages.RightResourceLibrary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GB_CadAndSWPlus_V.SolidWorksAddIn.DisplayPages"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
              d:Margin="0"
              d:MaxWidth="350"
              d:MinHeight="800"
              d:MinWidth="350">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MainWindowStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- SolidWorks 分类树主分类和子分类共用此右键菜单；菜单打开时通过 PlacementTarget 获取当前节点。 -->
            <ContextMenu x:Key="SolidWorksCategoryContextMenu" Opened="SW_CategoryContextMenu_Opened">
                <MenuItem Header="添加主分类" Click="SW_NewCategory_MenuItem_Click" />
                <MenuItem Header="添加子分类" Click="SW_AddSubcategory_MenuItem_Click" />
                <Separator />
                <MenuItem Header="修改分类" Click="SW_Edit_MenuItem_Click" />
                <MenuItem Header="删除分类" Click="SW_Delete_MenuItem_Click" />
                <Separator />
                <MenuItem Header="展开\折叠架构" Click="SW_展开_折叠架构_Click" />
                <MenuItem Header="刷新架构树" Click="SW_刷新架构树按钮_Click" />
            </ContextMenu>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White">
        <TabControl x:Name="LibraryTabControl"  ItemContainerStyle ="{StaticResource HorizontalTabStyle}">
            <TabItem x:Name="SW资源库" Header="SW资源库" Width="80"
                     FontSize="14"
                     FontWeight="Bold"
                     RenderTransformOrigin="0.5,0.5"
                     Margin="0,0,0,0"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Stretch">
                <Grid x:Name="SW专业图元"
                      Background="White"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="170" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="预览窗口" Grid.Row="0">
                        <!-- 图片与三维模型放在同一个预览窗口中，左侧显示图片，右侧显示三维模型。 -->
                        <Border x:Name="_3D预览" Height="170" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Top" BorderBrush="Gray" BorderThickness="1" Background="Black">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="White" BorderBrush="Gray" BorderThickness="0,0,1,0">
                                    <Image x:Name="SW_ViewImage" Width="170" Height="170" Stretch="Uniform" />
                                </Border>
                                <wv2:WebView2 x:Name="SW_ThreeDPreviewHost" Grid.Column="1" />
                            </Grid>
                        </Border>
                    </Grid>
                    <TabControl x:Name="MajroTabControl" Grid.Row="1"
                            Margin="0,0,0,0"
                            Padding="0,2,0,2"
                            Background="Azure"
                            ItemContainerStyle="{StaticResource VerticalTabStyle}"
                            SelectionChanged="TabControl_SelectionChanged"
                            TabStripPlacement="Left">
                        <TabItem x:Name="公用工具"
                                Height="68"
                                FontSize="12"
                                FontWeight="Bold"
                                Header="公用工具">
                            <Grid>
                                <TabControl>
                                    <TabItem x:Name="公用图元"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Header="公用图元">
                                        <Grid Background="White">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="24" />
                                            </Grid.RowDefinitions>
                                            <!-- SolidWorks 图元按钮按数据库分类动态生成；滚动容器避免图元数量增加后挤压其他页面。 -->
                                            <ScrollViewer Grid.Row="0"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto"
                                                          CanContentScroll="False">
                                                <WrapPanel x:Name="PublicButtonsPanel"
                                                           Margin="3"
                                                           HorizontalAlignment="Left" />
                                            </ScrollViewer>
                                            <TextBlock x:Name="PublicElementsStatusText"
                                                       Grid.Row="1"
                                                       Margin="4,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="Gray"
                                                       Text="登录后加载 SolidWorks 数据库图元。" />
                                        </Grid>
                                    </TabItem>
                                    <TabItem x:Name="常用工具"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Header="常用工具">
                                        <Grid x:Name="设置内容"
                                            Background="White"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="200" />
                                                <RowDefinition Height="50" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                        </Grid>
                                    </TabItem>

                                    <TabItem x:Name="图层工具"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Header="图层工具">
                                        <TabItem.Background>
                                            <LinearGradientBrush EndPoint="0,1">
                                                <GradientStop Offset="0.596" Color="#FFF0F0F0" />
                                            </LinearGradientBrush>
                                        </TabItem.Background>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="55" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <!-- 图层数据表 Layer Data Grid  -->
                                            <!--  状态信息  -->
                                            <TextBlock
                                                    x:Name="statusText"
                                                    Grid.Row="2"
                                                    Margin="5"
                                                    VerticalAlignment="Center"
                                                    Text="就绪" />
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="工艺"                                
                                     FontWeight="Bold"
                                     Header="工艺"
                                     IsSelected="True">
                            <TabControl
                                    x:Name="MajorTabControl"
                                    Padding="1,1,1,1"
                                    FontSize="12">
                                <TabItem x:Name="工艺图元" Header=" 工艺图元 ">
                                    <ScrollViewer x:Name="图元功能区" 
                                            Margin="0,0,0,0"
                                            FontSize="12"
                                             HorizontalScrollBarVisibility="Disabled"
                                            CanContentScroll="False"
                                            VerticalScrollBarVisibility="Auto">
                                        <Grid x:Name="按键功能区" HorizontalAlignment="Stretch">
                                            <Grid >
                                                <Grid Margin="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <GroupBox
                                                                x:Name="工艺处理"
                                                                Padding="0,3,0,0"
                                                                Header="工艺处理" Margin="0,5,0,0">
                                                            <WrapPanel x:Name="工艺处理按钮面板"
                                                                       Orientation="Horizontal"
                                                                       HorizontalAlignment="Stretch">
                                                                <Button x:Name="_1"                                                                         
                                                                            Width="95"
                                                                            Height="25"
                                                                            Margin="1,1,1,1"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Background="#FF0050A0"
                                                                            BorderBrush="#FFC2C6CE"
                                                                            Content="生成管道表"
                                                                            FontSize="12"
                                                                            Foreground="White" />
                                                                <Button x:Name="_2"
                                                                         Width="95"
                                                                         Height="25"
                                                                         Margin="2,1,1,1"
                                                                         HorizontalAlignment="Left"
                                                                         VerticalAlignment="Top"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Content="生成设备表"
                                                                         FontSize="12"
                                                                         Foreground="White" />
                                                                <Button x:Name="_3"
                                                                         Width="95"
                                                                         Height="25"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Content="插入管道表"
                                                                         FontSize="12"
                                                                         Foreground="White" Margin="2,1,1,1" />
                                                                <Button x:Name="_4"
                                                                         Width="95"
                                                                         Height="25"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Top"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Content="导出表格"
                                                                         FontSize="12"
                                                                         Foreground="White" Margin="1,1,1,1" />
                                                                <Button x:Name="_5"
                                                                         Width="95"
                                                                         Height="25"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Content="表格同步"
                                                                         FontSize="12"
                                                                         Foreground="White" Margin="2,1,1,1" />
                                                                <Button x:Name="_6"
                                                                         Width="95"
                                                                         Height="25"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Content="加载Excel表"
                                                                         FontSize="12"
                                                                         Foreground="White" Margin="2,1,1,1" />
                                                            </WrapPanel>
                                                        </GroupBox>
                                                    </Grid>
                                                    <Grid Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="214*" />
                                                        </Grid.ColumnDefinitions>
                                                    </Grid>
                                                    <WrapPanel
                                                            x:Name="CraftButtonsPanel"
                                                            Grid.Row="2"
                                                            Orientation="Vertical">
                                                        <WrapPanel x:Name="SolidWorksCraftDynamicPanel" Orientation="Vertical" />
                                                    </WrapPanel>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem x:Name="工艺管道计算" Header="管道计算表" >
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="60" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible"/>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="工艺_条件绘制" Header=" 条件绘制 ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                                Grid.Row="0"
                                                Margin="0"
                                                FontSize="10"
                                                VerticalScrollBarVisibility="Auto">
                                            <Grid Width="285" HorizontalAlignment="Left">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <StackPanel x:Name="ConditionsPanel" Orientation="Vertical">
                                                    <!--  工艺专业条件  -->
                                                    <!--  工艺专业标注  -->
                                                    <!--  电气专业条件  -->
                                                    <!--  给排水专业条件  -->
                                                    <!--  自控专业条件  -->
                                                    <!--  建筑专业条件  -->
                                                    <!--  结构专业条件  -->
                                                    <!--  暖通专业条件  -->

                                                </StackPanel>
                                            </Grid>
                                        </ScrollViewer>

                                    </Grid>
                                </TabItem>

                            </TabControl>
                        </TabItem>

                        <TabItem x:Name="建筑"
                                FontWeight="Bold"
                                Header="建筑">
                            <TabControl>
                                <TabItem x:Name="建筑图元" Header=" 图元集 ">
                                    <Grid>
                                        <Grid.RowDefinitions>

