                                                Margin="0"
                                                VerticalScrollBarVisibility="Auto">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1*" />
                                                    <RowDefinition Height="80" />
                                                </Grid.RowDefinitions>
                                                <WrapPanel
                                                        x:Name="ArchitectureButtonsPanel"
                                                        Grid.Row="0"
                                                        Orientation="Vertical">
                                                    <WrapPanel x:Name="SolidWorksArchitectureDynamicPanel" Orientation="Vertical" />
                                                </WrapPanel>
                                                <Grid Grid.Row="1" />

