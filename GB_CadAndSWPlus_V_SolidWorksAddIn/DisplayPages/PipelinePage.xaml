<Page x:Class="GB_CadAndSWPlus_V.SolidWorksAddIn.DisplayPages.PipelinePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#f7f7f7"
      Title="管道">
    <Page.Resources>
        <ResourceDictionary Source="pack://application:,,,/GB_CadAndSWPlus_V_SolidWorksAddIn;component/DisplayPages/Themes/Generic.xaml" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Expander Header="常规管道"
                      Style="{StaticResource TaskPane_ExpanderStyle}"
                      IsExpanded="True">
                <StackPanel Margin="7">
                    <TextBlock Text="液体管道" Margin="0,4" />
                    <TextBlock Text="气体管道" Margin="0,4" />
                    <TextBlock Text="油品管道" Margin="0,4" />
                    <Button Content="创建/打开平台装配体"
                            Margin="0,12,0,4"
                            Click="OpenPlatformAssembly_Click" />
                    <TextBlock x:Name="AssemblyStatusText"
                               TextWrapping="Wrap"
                               Foreground="#666666"
                               Margin="0,4" />
                </StackPanel>
            </Expander>

            <Expander Header="压力管道"
                      Style="{StaticResource TaskPane_ExpanderStyle}"
                      IsExpanded="True"
                      Margin="0,8,0,0">
                <StackPanel Margin="7">
                    <TextBlock Text="液体管道" Margin="0,4" />
                    <TextBlock Text="气体管道" Margin="0,4" />
                    <TextBlock Text="油品管道" Margin="0,4" />
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="确定" Width="75" Margin="0,0,8,0" />
                <Button Content="取消" Width="75" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
