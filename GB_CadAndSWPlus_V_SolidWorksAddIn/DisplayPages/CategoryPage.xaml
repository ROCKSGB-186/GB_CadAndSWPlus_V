<Page x:Class="GB_CadAndSWPlus_V.SolidWorksAddIn.DisplayPages.CategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#f7f7f7">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="共享分类" FontSize="18" FontWeight="Bold" />
            <Button Content="刷新" Width="70" DockPanel.Dock="Right" Click="Refresh_Click" />
        </DockPanel>
        <TreeView x:Name="CategoryTreeView" Grid.Row="1" />
        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</Page>
