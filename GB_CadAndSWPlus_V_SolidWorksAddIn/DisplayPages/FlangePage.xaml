<Page x:Class="GB_CadAndSWPlus_V.SolidWorksAddIn.DisplayPages.FlangePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#f7f7f7"
      Title="法兰">
    <Page.Resources>
        <ResourceDictionary Source="pack://application:,,,/GB_CadAndSWPlus_V_SolidWorksAddIn;component/DisplayPages/Themes/Generic.xaml" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Expander Header="法兰"
                      Style="{StaticResource TaskPane_ExpanderStyle}"
                      IsExpanded="True">
                <StackPanel Margin="7">
                    <TextBlock Text="平焊法兰" Margin="0,4" />
                    <TextBlock Text="对焊法兰" Margin="0,4" />
                    <TextBlock Text="盲板法兰" Margin="0,4" />
                    <TextBlock Text="一期：从统一图元库插入法兰" Margin="0,12,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="图元 ID" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="GraphicIdTextBox" Width="90" Text="1" />
                    </StackPanel>
                    <TextBox x:Name="LocalFallbackPathTextBox"
                             Margin="0,6,0,0"
                             ToolTip="可选：服务器不可用时使用的本地图元文件完整路径" />
                </StackPanel>
            </Expander>

            <Expander Header="压力等级"
                      Style="{StaticResource TaskPane_ExpanderStyle}"
                      IsExpanded="True"
                      Margin="0,8,0,0">
                <StackPanel Margin="7">
                    <TextBlock Text="PN1.0" Margin="0,4" />
                    <TextBlock Text="PN1.6" Margin="0,4" />
                    <TextBlock Text="PN2.5" Margin="0,4" />
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="插入图元" Width="85" Margin="0,0,8,0" Click="InsertGraphic_Click" />
                <Button Content="取消" Width="75" Click="Cancel_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#555555" />
        </StackPanel>
    </ScrollViewer>
</Page>
