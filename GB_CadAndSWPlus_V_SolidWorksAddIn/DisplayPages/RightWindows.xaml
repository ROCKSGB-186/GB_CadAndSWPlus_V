<UserControl x:Class="GB_CadAndSWPlus_V.SolidWorksAddIn.DisplayPages.RightWindows"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GB_CadAndSWPlus_V.SolidWorksAddIn.DisplayPages"
             mc:Ignorable="d" 
             Height="700" 
             Width="300"
             Background="#f7f7f7"
             FontFamily="{DynamicResource {x:Static SystemFonts.CaptionFontFamilyKey}}">
    <UserControl.Resources>
        <!-- 这里是窗体的资源字典，可以定义一些资源供窗体内使用,引用Generic.xaml资源字典 -->
        <ResourceDictionary Source="pack://application:,,,/GB_CadAndSWPlus_V_SolidWorksAddIn;component/DisplayPages/Themes/Generic.xaml"/>
    </UserControl.Resources>
   
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/><!-- 工具栏高度 -->
            <RowDefinition Height="5*"/><!-- 树形视图高度，百分比70 -->
            <RowDefinition Height="5*"/><!-- 文本框高度，百分比30 -->
        </Grid.RowDefinitions>
        <ToolBar>
            <Button Name="管道" 
                    Click="管道_Click">
                <StackPanel Orientation="Vertical">
                    <!-- 竖向排列 -->
                    <Image Width="25" Height="25" Source="./Icons/管道.png" Margin="0,0,0,0"/>
                    <!-- 设置图标的大小，图标文件，图标位置-->
                    <TextBlock Text="管道" Margin="0,0,0,0"/>
                    <!-- 文字名称与文字位置 -->
                </StackPanel>
            </Button>
            
            <Button Name="法兰" 
                    Click="法兰_Click">
                <StackPanel Orientation="Vertical">
                    <!-- 竖向排列 -->
                    <Image Width="25" Height="25" Source="/Icons/法兰.png" Margin="0,0,0,0"/>
                    <!-- 设置图标的大小，图标文件，图标位置-->
                    <TextBlock Text="法兰" Margin="0,0,0,0"/>
                    <!-- 文字名称与文字位置 -->
                </StackPanel>
            </Button>
        </ToolBar>
        <Separator Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="Gray"/>
        <TreeView Grid.Row="1" 
                  Name="treeView" 
                  Margin="5"
                  Background="#f7f7f7">
            <TreeViewItem Header="Item 1"
                          IsExpanded="True">
                <TreeViewItem Header="Subitem 1"/>
                <TreeViewItem Header="Subitem 2"/>
            </TreeViewItem>
            <TreeViewItem Header="Item 2"
                          IsExpanded="True">
                <TreeViewItem Header="Subitem 1"/>
                <TreeViewItem Header="Subitem 2"/>
            </TreeViewItem>
        </TreeView>
        <GridSplitter 
            Grid.Row="2" 
            Height="5"
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Top"
            Background="Gray"
            ResizeDirection="Rows" 
            ShowsPreview="True">
            <GridSplitter.ToolTip>
                <ToolTip Content="拖动以调整大小" />
            </GridSplitter.ToolTip>
        </GridSplitter>

        <TextBox Grid.Row="2" 
                 Name="textBox" 
                 Margin="5"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="#f7f7f7"/>

    </Grid>
    
</UserControl>
