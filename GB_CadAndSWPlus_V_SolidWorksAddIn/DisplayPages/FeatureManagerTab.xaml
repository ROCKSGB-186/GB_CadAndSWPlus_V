<UserControl x:Class="GB_CadAndSWPlus_V.SolidWorksAddIn.DisplayPages.FeatureManagerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GB_CadAndSWPlus_V.SolidWorksAddIn.DisplayPages"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="300" FontSize="15" Background="#f7f7f7">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="5*"/>

        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#e1e1e1" BorderBrush="Gray" BorderThickness="0,0,0,1">
            <TextBlock Text="特征管理器" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
        </Border>
        <TreeView Grid.Row="1" BorderThickness="0" >
            <TreeViewItem Header="零件"
                          IsExpanded="True">
                <TreeViewItem Header="History"/>

            </TreeViewItem>
            
        </TreeView>
        <Border Grid.Row="2" Background="#e1e1e1" BorderBrush="Gray" BorderThickness="1,1,1,1">
            <TextBlock Text="属性" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
        </Border>
    </Grid>
</UserControl>
