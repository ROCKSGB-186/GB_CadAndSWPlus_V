<UserControl x:Class="GB_CadAndSWPlus_V.Shared.UnifiedDepartmentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFECECEC">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.5*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="部门管理" FontWeight="Bold" FontSize="14" Margin="2,4,12,4" />
            <Button x:Name="SWRefreshDepartmentsButton" Content="获取部门" Click="SWRefreshDepartmentsButton_Click" Width="80" Margin="2" />
            <Button x:Name="SWAddDepartmentButton" Content="新增部门" Click="SWAddDepartmentButton_Click" Width="80" Margin="2" />
            <Button x:Name="SWDeleteDepartmentButton" Content="删除部门" Click="SWDeleteDepartmentButton_Click" Width="80" Margin="2" />
        </StackPanel>
        <DataGrid x:Name="SWDepartmentsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="SWDepartmentsGrid_SelectionChanged" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="35" />
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="显示名" Binding="{Binding DisplayName}" Width="*" />
                <DataGridTextColumn Header="数量" Binding="{Binding UserCount}" Width="45" />
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsActive}" Width="45" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="人员列表" FontWeight="Bold" FontSize="14" Margin="2,5" />
        <DataGrid x:Name="SWUsersGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="账号" Binding="{Binding Username}" Width="*" />
                <DataGridTextColumn Header="姓名" Binding="{Binding RealName}" Width="*" />
                <DataGridTextColumn Header="角色" Binding="{Binding Role}" Width="65" />
                <DataGridTextColumn Header="部门" Binding="{Binding DepartmentName}" Width="*" />
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsActive}" Width="45" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
