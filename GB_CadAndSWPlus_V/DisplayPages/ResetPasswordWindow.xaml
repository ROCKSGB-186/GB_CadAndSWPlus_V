<Window
    x:Class="GB_CadAndSWPlus_V.ResetPasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="修改密码"
    Width="380"
    Height="360"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14" FontSize="18" FontWeight="Bold" Foreground="#0078D4" Text="修改登录密码" />
        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="登录账号：" />
        <TextBox x:Name="TxtUsername" Grid.Row="1" Grid.Column="1" Margin="4,4,0,4" />
        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="手机号：" />
        <TextBox x:Name="TxtPhone" Grid.Row="2" Grid.Column="1" Margin="4,4,0,4" />
        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="邮箱：" />
        <TextBox x:Name="TxtEmail" Grid.Row="3" Grid.Column="1" Margin="4,4,0,4" />
        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="新密码：" />
        <PasswordBox x:Name="PwdNewPassword" Grid.Row="4" Grid.Column="1" Margin="4,4,0,4" />
        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="确认密码：" />
        <PasswordBox x:Name="PwdConfirmPassword" Grid.Row="5" Grid.Column="1" Margin="4,4,0,4" />
        <TextBlock x:Name="TxtStatus" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,12,0,8" Foreground="Gray" TextWrapping="Wrap" />
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="80" Margin="4" Click="BtnCancel_Click" Content="取消" />
            <Button x:Name="BtnReset" Width="80" Margin="4" Click="BtnReset_Click" Content="确认修改" />
        </StackPanel>
    </Grid>
</Window>
