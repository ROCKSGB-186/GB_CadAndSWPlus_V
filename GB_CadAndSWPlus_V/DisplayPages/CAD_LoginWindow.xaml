<Window
    x:Class="GB_CadAndSWPlus_V.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="760"
    Height="540"
    MinWidth="760"
    MinHeight="540"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Background="#F4F7FB"
    FontFamily="Microsoft YaHei UI"
    mc:Ignorable="d">
    <Window.Resources>
        <!-- CAD 与 SolidWorks 登录页统一使用自包含样式，避免影响 CAD 其他窗口。 -->
        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0,42,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="LoginComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1677C8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Foreground" Value="#526274" />
            <Setter Property="Background" Value="#EEF2F6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="White" BorderBrush="#DCE5EF" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 品牌区：明确 CAD 与 SolidWorks 使用同一套工程平台账号。 -->
            <Border Grid.Column="0" CornerRadius="8,0,0,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0B4F88" Offset="0" />
                        <GradientStop Color="#1677C8" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" >
                            <Image Source="/GB_CadAndSWPlus_V;component/DisplayPages/Icons/沈阳铝镁院LOGO_NEW.png"
                                   Width="42"
                                   Height="42"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="12,1,0,0">
                            <TextBlock Foreground="White" FontSize="19" FontWeight="Bold"><Run Language="zh-cn" Text="沈阳铝镁研究院" /></TextBlock>
                            <TextBlock Text="统一账号中心" Foreground="#D6ECFF" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="欢迎回来" Foreground="White" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="一次登录，连接 CAD 与 SolidWorks" Foreground="#E2F2FF" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <Border Height="1" Background="#55FFFFFF" Margin="0,22,0,20" />
                        <TextBlock Text="统一访问工程数据、图元属性和三维模型服务。" Foreground="#D6ECFF" FontSize="12" TextWrapping="Wrap" LineHeight="22" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="CAD  ·  SolidWorks  ·  工程协同" Foreground="#BFE3FF" FontSize="11" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="30,24,30,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="登录" Grid.Row="0" Foreground="#1F2D3D" FontSize="22" FontWeight="Bold" ><Run Language="zh-cn" Text="SW\CAD辅助设计"/><Run Text="平台"/></TextBlock>
                <TextBlock Grid.Row="1" Text="使用统一账号访问 CAD 工程设计平台" Foreground="#8090A2" FontSize="12" Margin="0,6,0,16" />

                <StackPanel x:Name="部门与用户名密码" Grid.Row="2">
                    <TextBlock Text="注册部门" Foreground="#526274" FontSize="12" Margin="0,0,0,6" />
                    <ComboBox x:Name="CmbDepartments" Style="{StaticResource LoginComboBoxStyle}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" />

                    <TextBlock Text="用户名" Foreground="#526274" FontSize="12" Margin="0,12,0,6" />
                    <TextBox x:Name="Login_Username" Style="{StaticResource LoginTextBoxStyle}" TextChanged="Login_Username_TextChanged" />

                    <TextBlock Text="密码" Foreground="#526274" FontSize="12" Margin="0,12,0,6" />
                    <Grid Height="36">
                        <PasswordBox x:Name="Login_Password" Style="{StaticResource LoginPasswordBoxStyle}" />
                        <TextBox x:Name="Login_PasswordVisible" Style="{StaticResource LoginTextBoxStyle}" Padding="12,0,42,0" TextChanged="Login_PasswordVisible_TextChanged" Visibility="Collapsed" />
                        <Button x:Name="BtnTogglePassword"
                                Width="38"
                                Height="34"
                                Margin="0,1,1,1"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="BtnTogglePassword_Click"
                                Content="👁"
                                FontFamily="Segoe UI Symbol"
                                FontSize="15"
                                Foreground="#6B7C8F"
                                ToolTip="显示密码" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <CheckBox x:Name="ChkSavePassword" Content="保存密码" Foreground="#526274" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Hyperlink Click="ForgetPassword_Click" Foreground="#1677C8">
                                <Run Text="修改密码" />
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <Button x:Name="BtnToggleServerSettings"
                        Grid.Row="3"
                        Height="28"
                        Margin="0,12,0,4"
                        HorizontalAlignment="Left"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BtnToggleServerSettings_Click"
                        Content="显示服务器配置"
                        FontSize="12"
                        Foreground="#1677C8"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center" />

                <Border Grid.Row="4" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="5" Padding="14,10" Margin="0,0,0,6">
                    <StackPanel x:Name="ServerSettingsPanel" Visibility="Collapsed">
                        <TextBlock Text="服务器配置" Foreground="#1F2D3D" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="数据库类型" Foreground="#526274" FontSize="11" Margin="0,0,0,5" />
                                <ComboBox x:Name="CmbDatabaseType" Style="{StaticResource LoginComboBoxStyle}" SelectionChanged="CmbDatabaseType_SelectionChanged">
                                    <ComboBoxItem Content="DM" />
                                    <ComboBoxItem Content="MYSQL" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="数据库端口" Foreground="#526274" FontSize="11" Margin="0,0,0,5" />
                                <TextBox x:Name="Login_DataBaseserverPort" Style="{StaticResource LoginTextBoxStyle}" PreviewTextInput="TxtServerPort_PreviewTextInput" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="服务器 IP / 主机名" Foreground="#526274" FontSize="11" Margin="0,10,0,5" />
                        <TextBox x:Name="Login_ServerIP" Style="{StaticResource LoginTextBoxStyle}" Tag="例如：服务器 IP 或主机名" />
                        <TextBlock Text="API 服务端口" Foreground="#526274" FontSize="11" Margin="0,10,0,5" />
                        <TextBox x:Name="Login_ApiPort" Style="{StaticResource LoginTextBoxStyle}" PreviewTextInput="TxtServerPort_PreviewTextInput" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TxtStatus" Grid.Row="5" Foreground="#526274" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,4,0,4" />

                <StackPanel x:Name="ServerActionsPanel" Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed" Margin="0,4,0,4">
                    <Button x:Name="BtnTestServer测试服务器" Content="测试服务器" Width="100" Height="30" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnTestServer测试服务器_Click" />
                    <Button x:Name="BtnSaveServer" Content="保存服务器配置" Width="132" Height="30" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSaveServer_Click" />
                </StackPanel>

                <StackPanel x:Name="登录与取消按键" Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="BtnCancel" Content="取消" Width="86" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click" Margin="0,0,10,0" />
                    <Button x:Name="BtnLogin" Content="登录" Width="106" Style="{StaticResource PrimaryButtonStyle}" Click="BtnLogin_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
