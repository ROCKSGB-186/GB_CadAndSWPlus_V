<Window x:Class="GB_CadAndSWPlus_V.DisplayPages.StandardImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1080"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        Title="规范导入预览"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="25" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="20" FontWeight="Bold" Foreground="#0078D4" Text="规范导入预览" />
                <TextBlock Margin="0,4,0,0" Foreground="#666666" Text="请核对规范名称、数据内容和校验结果，再确认导入。" FontSize="14" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Text="原始文件" />
                <TextBlock HorizontalAlignment="Right" Foreground="#666666" Text="{Binding SourceFileName}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,0,0,8" Padding="10" Background="#FFF3F6FA" BorderBrush="#FFB8C7D9" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontWeight="Bold" Text="规范注释名称" FontSize="14" />
                <TextBox Grid.Column="1" MinWidth="130" Text="{Binding Series.SeriesName, UpdateSourceTrigger=PropertyChanged}" TextChanged="MetadataTextBox_TextChanged" TextBlock.FontSize="14" />
                <TextBlock Grid.Column="2" Margin="16,0,6,0" VerticalAlignment="Center" FontWeight="Bold" Text="规范代号" FontSize="14" />
                <TextBox Grid.Column="3" MinWidth="120" Text="{Binding Series.StandardNumber, UpdateSourceTrigger=PropertyChanged}" TextChanged="MetadataTextBox_TextChanged" TextBlock.FontSize="14" />
                <TextBlock Grid.Column="4" Margin="16,0,6,0" VerticalAlignment="Center" FontWeight="Bold" Text="表号" FontSize="14" />
                <TextBox Grid.Column="5" MinWidth="90" Text="{Binding Series.TableNumber, UpdateSourceTrigger=PropertyChanged}" TextChanged="MetadataTextBox_TextChanged" TextBlock.FontSize="14" />
                <TextBlock Grid.Column="6" Margin="16,0,6,0" VerticalAlignment="Center" FontWeight="Bold" Text="型号" FontSize="14" />
                <TextBox Grid.Column="7" MinWidth="90" Text="{Binding Series.PressureRating, UpdateSourceTrigger=PropertyChanged}" TextChanged="MetadataTextBox_TextChanged" TextBlock.FontSize="14" />

                <TextBlock Grid.Row="1" Margin="0,10,6,0" VerticalAlignment="Center" FontWeight="Bold" Text="最终规范名" FontSize="14" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="7" Margin="0,10,0,0" FontSize="16" FontWeight="Bold" Foreground="#C00000" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Grid.Column="3" Margin="128,13,6,0" VerticalAlignment="Top" FontWeight="Bold" Text="所在基础规范:" FontSize="14" />
                <ComboBox x:Name="所在基础规范ComBox" Grid.Row="1" Grid.Column="3" Margin="232,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Grid.ColumnSpan="5" IsEditable="True" IsTextSearchEnabled="True" SelectionChanged="所在基础规范ComBox_SelectionChanged" DropDownClosed="所在基础规范ComBox_DropDownClosed" Loaded="所在基础规范ComBox_Loaded" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,0,0,8" Padding="8" Background="#FFF7F7F7" BorderBrush="#FFD0D0D0" BorderThickness="1" Visibility="{Binding DynamicTemplateVisibility}">
            <StackPanel>
                <TextBlock FontWeight="Bold" Text="{Binding DynamicTemplateStatus}" />
                <TextBlock Margin="0,3,0,0" Foreground="#666666" Text="{Binding DynamicTemplateDetail}" TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0" FontWeight="Bold" Foreground="#0078D4" Text="{Binding DynamicTargetSeriesStatus}" TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0" Foreground="#6A0DAD" Text="{Binding DynamicUnmappedHeaders}" TextWrapping="Wrap" />
                <TextBlock Margin="0,5,0,0" Foreground="#C00000" Text="{Binding DynamicUpdateDescription}" TextWrapping="Wrap" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal" Visibility="{Binding DynamicMergeVisibility}">
                    <RadioButton Content="新版替换（保留旧版本）" IsChecked="{Binding IsReplaceStrategy, Mode=TwoWay}" Checked="UpdateStrategyRadioButton_Checked" />
                    <RadioButton Margin="16,0,0,0" Content="融合更新（需唯一键）" IsChecked="{Binding IsMergeStrategy, Mode=TwoWay}" Checked="UpdateStrategyRadioButton_Checked" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,0,0,8" Padding="10" BorderBrush="#FFD69E2E" BorderThickness="1" Visibility="{Binding DuplicateVisibility}">
            <StackPanel>
                <TextBlock FontWeight="Bold" Foreground="#C00000" Text="发现已有同名规范" FontSize="14" />
                <TextBlock Margin="0,4,0,0" Text="{Binding DuplicateDescription}" TextWrapping="Wrap" FontSize="14" />
                <TextBlock Margin="0,4,0,0" Foreground="#C00000" Text="请选择的处理方式将在完成法兰记录版本快照后启用；当前为保护历史数据，不允许提交同名规范。" TextWrapping="Wrap" FontSize="14" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <RadioButton IsEnabled="False" Content="创建新版本（下一阶段启用）" TextBlock.FontSize="14" />
                    <RadioButton Margin="16,0,0,0" IsEnabled="False" Content="覆盖当前数据（下一阶段启用）" TextBlock.FontSize="14" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="Bold" Text="规范内容预览" />
                <ComboBox x:Name="RowFilterComboBox" Width="120" Margin="12,0,0,0" SelectedIndex="0" SelectionChanged="RowFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="全部数据" />
                    <ComboBoxItem Content="仅正常" />
                    <ComboBoxItem Content="仅警告" />
                    <ComboBoxItem Content="仅错误" />
                </ComboBox>
                <TextBlock Margin="12,2,0,0" Foreground="#666666" Text="{Binding SummaryText}" />
            </DockPanel>
            <DataGrid x:Name="PreviewDataGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      ColumnWidth="*"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="All"
                      IsReadOnly="True"
                      SelectionMode="Single" FontSize="14">
            </DataGrid>
        </Grid>

        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <CheckBox x:Name="WarningConfirmedCheckBox" Visibility="{Binding WarningConfirmationVisibility}" Checked="WarningConfirmedCheckBox_Changed" Unchecked="WarningConfirmedCheckBox_Changed" Content="我已核对并确认以上警告，可以继续导入。" FontSize="14" />
                <TextBlock Margin="0,4,0,0" Foreground="#C00000" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="286" HorizontalAlignment="Right">
                <Button Width="130" Margin="8,0,0,0" Click="CancelButton_Click" Content="取消" IsCancel="True" FontSize="16" />
                <Button x:Name="ConfirmButton" Width="130" Margin="8,0,0,0" Click="ConfirmButton_Click" Content="确定导入" IsDefault="True" FontSize="16" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
