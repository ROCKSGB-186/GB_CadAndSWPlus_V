                            Grid.Column="2"
                            Margin="2,0,0,0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            FontSize="11"
                            FontStyle="Normal"
                            GridLinesVisibility="All"
                            HeadersVisibility="Column"
                            HorizontalScrollBarVisibility="Auto"
                            Loaded="StroageFileDataGrid_Loaded"
                            MouseDoubleClick="StroageFileDataGrid_MouseDoubleClick"
                            SelectedCellsChanged="StroageFileDataGrid_SelectedCellsChanged"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            TargetUpdated="StroageFileDataGrid_TargetUpdated"
                            VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <!--  文件名列 - 支持自动换行  -->
                                <DataGridTextColumn
                                    Width="*"
                                    CanUserResize="True"
                                    Header="文件名">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="DisplayName" />
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>

                                <!--  预览图片列  -->
                                <DataGridTemplateColumn
                                    Width="80"
                                    CanUserResize="False"
                                    Header="预览">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Image
                                                    x:Name="PreviewImage"
                                                    Width="80"
                                                    Height="60"
                                                    Loaded="PreviewImage_Loaded"
                                                    Stretch="Uniform">
                                                    <Image.Tag>
                                                        <Binding Path="." />
                                                    </Image.Tag>
                                                </Image>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <!--  设置DataGrid的行样式  -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Height" Value="70" />

                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                    <!--  第四行  -->
                    <Grid
                        Grid.Row="3"
                        Height="155"
                        Background="Azure">
                        <Button
                            Width="NaN"
                            Height="22"
                            MaxWidth="200"
                            MaxHeight="50"
                            Margin="5,3,257,127"
                            Click="SelectFile_Btn_Click"
                            FontSize="14">
                            <TextBlock
                                x:Name="addGraphice"
                                FontSize="12"
                                Text="选择图元文件" />
                        </Button>
                        <TextBox
                            x:Name="filePath"
                            Width="245"
                            Height="20"
                            Margin="90,0,0,129"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            AcceptsTab="True"
                            BorderThickness="1,2,1,1"
                            FontSize="8"
                            SelectionOpacity="0.5"
                            Style="{StaticResource WatermarkTextBoxStyle}"
                            Tag="文件路径："
                            TextWrapping="Wrap" />
                        <Button
                            Width="NaN"
                            Height="22"
                            MaxWidth="200"
                            MaxHeight="50"
                            Margin="5,28,257,105"
                            Click="SelectViewImage_Btn_Click"
                            FontSize="14">
                            <TextBlock
                                x:Name="delGraphice"
                                FontSize="12"
                                Text="选择预览图" />
                        </Button>
                        <TextBox
                            x:Name="viewFilePath"
                            Width="245"
                            Height="20"
                            Margin="90,0,0,106"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            AcceptsTab="True"
                            BorderThickness="1,2,1,1"
                            FontSize="8"
                            SelectionOpacity="0.5"
                            Style="{StaticResource WatermarkTextBoxStyle}"
                            Tag="预览图文件路径："
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="FileName"
                            Width="147"
                            Height="20"
                            Margin="90,0,0,83"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            AcceptsTab="True"
                            BorderThickness="1,2,1,1"
                            FontSize="10"
                            SelectionOpacity="0.5"
                            Style="{StaticResource WatermarkTextBoxStyle}"
                            Tag="文件名称："
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="FileSize"
                            Width="147"
                            Height="20"
                            Margin="90,0,0,60"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            AcceptsTab="True"
                            BorderThickness="1,2,1,1"
                            FontSize="10"
                            SelectionOpacity="0.5"
                            Style="{StaticResource WatermarkTextBoxStyle}"
                            Tag="文件大小："
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="ClientVersion"
                            Width="147"
                            Height="20"
                            Margin="90,0,0,36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            AcceptsTab="True"
                            BorderThickness="1,2,1,1"
                            FontSize="10"
                            SelectionOpacity="0.5"
                            Style="{StaticResource WatermarkTextBoxStyle}"
                            Tag="客户端版本号："
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="DeleteGraphicBtn"
                            Width="NaN"
                            Height="22"
                            MaxWidth="200"
                            MaxHeight="50"
                            Margin="5,51,257,82"
                            Click="DeleteGraphic_Btn_Click"
                            Content="删除图元"
                            FontSize="12" />
                        <Button
                            Width="70"
                            Height="22"
                            MaxWidth="200"
                            MaxHeight="50"
                            Margin="90,127,182,6"
                            Click="ResetToInitial_Btn_Click"
                            Content="还原初始值"
                            FontSize="12" />
                        <Button
                            x:Name="ApplyPropertiesBtn"
                            Width="70"
                            Height="22"
                            MaxWidth="200"
                            MaxHeight="50"
                            Margin="167,127,105,6"
                            Click="ApplyProperties_Btn_Click"
                            Content="应用属性"
                            FontSize="12" />
                        <Button
                            x:Name="AddFileBtn"
                            Width="NaN"
                            Height="28"
                            MaxWidth="200"
                            MaxHeight="50"
                            Margin="5,123,257,4"
                            Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                            Click="AddFile_Btn_Click"
                            Content="完成添加"
                            FontSize="14"
                            Foreground="White" />
                        <Button
                            x:Name="ImportFromSelectionBtn"
                            Width="80"
                            Height="22"
                            MaxWidth="80"
                            MaxHeight="22"
                            Margin="5,0,0,59"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Click="ImportFromSelection_Btn_Click"
                            Content="添加当前图形入库"
                            FontSize="10" />
                        <Button
                            x:Name="上传客户端"
                            Width="80"
                            Height="22"
                            MaxWidth="80"
                            MaxHeight="22"
                            Margin="5,0,0,36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Click="上传客户端_Btn_Click"
                            Content="上传客户端"
                            FontSize="12" />
                        <Image
                            x:Name="ViewImage"
                            Width="100"
                            Height="100"
                            Margin="239,52,3,3"
                            Stretch="Uniform" />

                    </Grid>
                    <Grid Grid.Row="4" Background="FloralWhite" />
                    <Grid Grid.Row="5">
                        <ScrollViewer Margin="0,0,0,0" VerticalScrollBarVisibility="Auto">
                            <!--  属性编辑DataGrid  -->
                            <DataGrid
                                x:Name="CategoryPropertiesDataGrid"
                                Grid.Row="0"
                                Margin="0"
                                AutoGenerateColumns="False"
                                CanUserAddRows="True"
                                CanUserDeleteRows="True"
                                FontSize="11"
                                GridLinesVisibility="All"
                                HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="70" Header="属性名称1">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PropertyName1}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox
                                                    InputMethod.IsInputMethodEnabled="True"
                                                    Language="zh-CN"
                                                    Text="{Binding PropertyName1, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="*" Header="值1">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PropertyValue1}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox
                                                    InputMethod.IsInputMethodEnabled="True"
                                                    Language="zh-CN"
                                                    Text="{Binding PropertyValue1, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="70" Header="属性名称2">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PropertyName2}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox
                                                    InputMethod.IsInputMethodEnabled="True"
                                                    Language="zh-CN"
                                                    Text="{Binding PropertyName2, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="*" Header="值2">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PropertyValue2}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox
                                                    InputMethod.IsInputMethodEnabled="True"
                                                    Language="zh-CN"
                                                    Text="{Binding PropertyValue2, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <!--  第四TabControlItem(部门_人员模块)  -->
            <TabItem x:Name="部门_人员模块_TabItem"
                Width="105"
                Header="部门\人员模块"
                FontSize="14"
                FontWeight="Bold"
                     Margin="0,0,0,0"  >
                <Grid x:Name="部门_人员模块_Grid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="1.5*" />
                    </Grid.RowDefinitions>

                    <Grid Name="部门管理页面"
                        Grid.Column="0"
                        Margin="0"
                        Background="#FFECECEC">
                        <!-- 部门表格使用 * 行，随模块高度自动填充 -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="部门管理"
                            Grid.Row="0"
                            Margin="0,5,0,5"
                            Background="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                            FontSize="15"
                            FontWeight="Bold"
                            Text=" 部门管理" />
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,0,0,3"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">
                            <Button
                                x:Name="BtnSync"
                                Width="90"
                                Margin="0,0,3,0"
                                Click="BtnSync_Click"
                                Content="获取部门" />
                            <Button
                                x:Name="BtnAddDept"
                                Width="80"
                                Margin="0,0,3,0"
                                Click="BtnAddDept_Click"
                                Content="新增部门" />
                            <Button
                                x:Name="BtnEditDept"
                                Width="80"
                                Margin="0,0,3,0"
                                Click="BtnEditDept_Click"
                                Content="编辑部门" />
                            <Button
                                x:Name="BtnDeleteDept"
                                Width="80"
                                Click="BtnDeleteDept_Click"
                                Content="删除部门" />
                        </StackPanel>
                        <DataGrid
                            x:Name="DepartmentsGrid"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            SelectionChanged="DepartmentsGrid_SelectionChanged"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="35"
                                    Binding="{Binding Id}"
                                    Header="ID" />
                                <DataGridTextColumn
                                    Width="95"
                                    Binding="{Binding Name}"
                                    Header="名称" />
                                <DataGridTextColumn
                                    Width="95"
                                    Binding="{Binding DisplayName}"
                                    Header="显示名" />
                                <DataGridTextColumn
                                    Width="38"
                                    Binding="{Binding UserCount}"
                                    Header="数量" />
                                <DataGridTextColumn
                                    Width="38"
                                    Binding="{Binding SortOrder}"
                                    Header="排序" />
                                <DataGridCheckBoxColumn
                                    Width="35"
                                    Binding="{Binding IsActive}"
                                    Header="启用" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid x:Name="部门用户_分配_Grid" 
                        Grid.Row="2"
                        Margin="0"
                        Background="#FFECECEC">
                        <!-- 用户表格使用 * 行，随模块高度自动填充 -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="部门用户_分配"
                            Grid.Row="0"
                            Margin="0,5,0,5"
                            Background="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}"
                            FontSize="14"
                            FontWeight="Bold"
                            Text=" 部门用户 / 分配" />
                        <StackPanel x:Name="部门用户_分配_StackPanel"
                            Grid.Row="1"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">
                            <Button
                                x:Name="BtnRefresh"
                                Width="80"
                                Height="25"
                                Margin="1,1,5,1"
                                Click="BtnRefresh_Click"
                                Content="刷新" />
                            <Button
                                x:Name="BtnAddUserManaged"
                                Width="80"
                                Height="25"
                                Margin="1,1,5,1"
                                HorizontalContentAlignment="Left"
                                Click="BtnAddUserManaged_Click"
                                Content="增加人员" />
                            <Button
                                x:Name="BtnEditUserManaged"
                                Width="80"
                                Height="25"
                                Margin="1,1,5,1"
                                Click="BtnEditUserManaged_Click"
                                Content="编辑人员" />
                            <Button
                                x:Name="BtnDeleteUserManaged"
                                Width="80"
                                Height="25"
                                Margin="1,1,0,1"
                                Click="BtnDeleteUserManaged_Click"
                                Content="删除人员" />
                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            Margin="0,3,0,3"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                            <TextBox
                                x:Name="TxtSearchUser"
                                Width="180"
                                Margin="5,0,5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontWeight="Normal"
                                Text="输入用户名搜索/分配" />
                            <Button
                                x:Name="BtnAssignUser"
                                Width="150"
                                Height="20"
                                Margin="2,1,1,1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Click="BtnAssignUser_Click"
                                Content="将用户分配到选中部门" />
                        </StackPanel>

                        <DataGrid
                            x:Name="UsersGrid"
                            Grid.Row="3"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="40"
                                    Binding="{Binding Id}"
                                    Header="ID" />
                                <DataGridTextColumn
                                    Width="85"
                                    Binding="{Binding Username}"
                                    Header="用户名" />
                                <DataGridTextColumn
                                    Width="85"
                                    Binding="{Binding FullName}"
                                    Header="姓名" />
                                <DataGridTextColumn
                                    Width="123"
                                    Binding="{Binding Phone}"
                                    Header="电话" />
                            </DataGrid.Columns>
                        </DataGrid>


                    </Grid>

                    <StackPanel
                        Grid.Row="2"
                        Width="154"
                        Height="22"
                        Margin="10,0,0,58"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom" />

                    <StackPanel
                        Grid.Row="2"
                        Height="50"
                        VerticalAlignment="Bottom">
                        <TextBlock
                            x:Name="TxtStatus"
                            Height="45"
                            Margin="0,0,0,0"
                            Foreground="Gray"
                            TextWrapping="Wrap" />
                    </StackPanel>

                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
