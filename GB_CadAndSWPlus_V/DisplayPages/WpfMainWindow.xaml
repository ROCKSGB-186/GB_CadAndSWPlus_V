<UserControl
    x:Class="GB_CadAndSWPlus_V.WpfMainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GB_CadAndSWPlus_V"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
    xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
    xmlns:displayPages="clr-namespace:GB_CadAndSWPlus_V.DisplayPages"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    d:Margin="0"
    d:MaxWidth="350"
    d:MinHeight="800"
    d:MinWidth="350"
    d:Name="MainWindows"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  引用外部样式资源文件  -->
                <ResourceDictionary Source="/GB_CadAndSWPlus_V;component/DisplayPages/MainWindowStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        MinWidth="350"
        MinHeight="700"
        MaxWidth="350"
        Background="White">
        <TabControl x:Name="MainTabControl"
            ItemContainerStyle ="{StaticResource HorizontalTabStyle}"
                    Padding="0,2,0,2" >
            <!--  第一TabControlItem(图元)  -->
            <TabItem x:Name="CAD图元" Header="CAD图元" Height="28"  Width="68"
                     FontSize="14"
                     FontWeight="Bold"
                     RenderTransformOrigin="0.5,0.5"
                     Margin="0,0,0,0">

                <Grid x:Name="CAD图元Grid" >

                    <Grid.RowDefinitions>
                        <RowDefinition Height="125" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="35" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="120" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                        Margin="0,0,0,0"
                        Background="Azure">
                        <Button
                            x:Name="上"
                            Width="32"
                            Height="32"
                            Margin="267,82,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Click="上_Btn_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="pack://application:,,,/GB_CadAndSWPlus_V;component/Resources/上.png" />
                            </Button.Background>
                        </Button>
                        <Button
                            x:Name="右上"
                            Width="32"
                            Height="32"
                            Margin="230,82,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Click="右上_Btn_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="pack://application:,,,/GB_CadAndSWPlus_V;component/Resources/右上.png" />
                            </Button.Background>
                        </Button>
                        <Button
                            x:Name="右"
                            Width="32"
                            Height="32"
                            Margin="230,45,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Click="右_Btn_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="pack://application:,,,/GB_CadAndSWPlus_V;component/Resources/右.png" />
                            </Button.Background>
                        </Button>
                        <Button
                            x:Name="右下"
                            Width="32"
                            Height="32"
                            Margin="230,8,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Click="右下_Btn_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="pack://application:,,,/GB_CadAndSWPlus_V;component/Resources/右下.png" />
                            </Button.Background>
                        </Button>
                        <Button
                            x:Name="左上"
                            Width="32"
                            Height="32"
                            Margin="304,82,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Click="左上_Btn_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="pack://application:,,,/GB_CadAndSWPlus_V;component/Resources/左上.png" />
                            </Button.Background>
                        </Button>
                        <Button
                            x:Name="左"
                            Width="32"
                            Height="32"
                            Margin="304,45,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Click="左_Btn_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="pack://application:,,,/GB_CadAndSWPlus_V;component/Resources/左.png" />
                            </Button.Background>
                        </Button>
                        <Button
                            x:Name="左下"
                            Width="32"
                            Height="32"
                            Margin="304,8,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Click="左下_Btn_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="pack://application:,,,/GB_CadAndSWPlus_V;component/Resources/左下.png" />
                            </Button.Background>
                        </Button>
                        <Button
                            x:Name="下"
                            Width="32"
                            Height="32"
                            Margin="267,8,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Click="下_Btn_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="pack://application:,,,/GB_CadAndSWPlus_V;component/Resources/下.png" />
                            </Button.Background>
                        </Button>
                        <TextBlock
                            Margin="5,0,300,100"
                            FontSize="10"
                            FontWeight="Normal"
                            Text="预览：" />
                        <Image x:Name="预览" Margin="5,0,120,0" />

                    </Grid>

                    <Grid Grid.Row="1" />

                    <Grid Grid.Row="2"
                        Height="26"
                        Background="FloralWhite">
                        <Button
                            x:Name="查找"
                            Width="60"
                            Height="22"
                            Margin="6,4,276,0"
                            VerticalAlignment="Top"
                            Click="查找_Btn_Click"
                            Content="查找"
                            FontSize="11" />
                        <TextBox
                            Width="120"
                            Height="22"
                            Margin="70,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            AcceptsTab="True"
                            BorderThickness="1,2,1,1"
                            FontSize="12"
                            SelectionOpacity="0.5"
                            Style="{StaticResource WatermarkTextBoxStyle}"
                            Tag="请输入关键字"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="PU"
                            Width="45"
                            Height="22"
                            Margin="195,4,102,0"
                            VerticalAlignment="Top"
                            Click="功能1_Btn_Click"
                            Content="PU"
                            FontSize="11" />
                        <Button
                            x:Name="Audit"
                            Width="45"
                            Height="22"
                            Margin="245,4,52,0"
                            VerticalAlignment="Top"
                            Click="功能2_Btn_Click"
                            Content="Audit"
                            FontSize="11" />
                        <Button
                            x:Name="Recover"
                            Width="45"
                            Height="22"
                            Margin="294,4,3,0"
                            VerticalAlignment="Top"
                            Click="功能3_Btn_Click"
                            Content="恢复"
                            FontSize="11" />
                    </Grid>

                    <Grid Grid.Row="3" />

                    <Grid Grid.Row="4"
                          Background="Azure">
                        <TabControl x:Name="MajroTabControl"
                            Margin="0,0,0,0"
                            Padding="0,2,0,2"
                            Background="Azure"
                            ItemContainerStyle="{StaticResource VerticalTabStyle}"
                            SelectionChanged="TabControl_SelectionChanged"
                            TabStripPlacement="Left">
                            <TabItem x:Name="公用工具"
                                Height="68"
                                FontSize="12"
                                FontWeight="Bold"
                                Header="公用工具">
                                <Grid>
                                    <TabControl>
                                        <TabItem x:Name="公用图元"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Header="公用图元">
                                            <WrapPanel x:Name="PublicButtonsPanel" />
                                        </TabItem>

                                        <TabItem x:Name="常用工具"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Header="常用工具">
                                            <Grid>
                                                <GroupBox
                                                    x:Name="块处理"
                                                    Height="65"
                                                    Margin="5,5,5,0"
                                                    Padding="0,3,0,0"
                                                    VerticalAlignment="Top"
                                                    FontFamily="Microsoft YaHei UI"
                                                    Header="块处理">
                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

                                                        <Button
                                                            x:Name="分解块"
                                                            Width="100"
                                                            Height="25"
                                                            Margin="2,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="#FF0050A0"
                                                            BorderBrush="#FFC2C6CE"
                                                            Click="分解块_Btn_Click"
                                                            Content="选择块并分解"
                                                            FontSize="12"
                                                            Foreground="White" />
                                                        <Button
                                                            x:Name="分解图层块"
                                                            Width="100"
                                                            Height="25"
                                                            Margin="105,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="#FF0050A0"
                                                            BorderBrush="#FFC2C6CE"
                                                            Click="分解图层块_Btn_Click"
                                                            Content="选图层并分解块"
                                                            FontSize="12"
                                                            Foreground="White" />
                                                        <TextBox
                                                            x:Name="清理参数"
                                                            Width="70"
                                                            Height="22"
                                                            Margin="210,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            AcceptsTab="True"
                                                            BorderThickness="1,2,1,1"
                                                            FontSize="12"
                                                            SelectionOpacity="0.5"
                                                            Style="{StaticResource WatermarkTextBoxStyle}"
                                                            Tag="清理参数"
                                                            TextChanged="CleanupParameter_TextChanged"
                                                            TextWrapping="Wrap" />
                                                    </Grid>
                                                </GroupBox>


                                            </Grid>
                                        </TabItem>

                                        <TabItem x:Name="图层工具"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Header="图层工具">
                                            <TabItem.Background>
                                                <LinearGradientBrush EndPoint="0,1">
                                                    <GradientStop Offset="0.596" Color="#FFF0F0F0" />
                                                </LinearGradientBrush>
                                            </TabItem.Background>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="55" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <WrapPanel
                                                    Grid.Row="0"
                                                    Grid.RowSpan="2"
                                                    Height="60"
                                                    Margin="0,0,0,0"
                                                    VerticalAlignment="Top">
                                                    <Button
                                                        x:Name="加载当前图层"
                                                        Width="95"
                                                        Height="20"
                                                        Margin="3,5,0,0"
                                                        Background="AliceBlue"
                                                        Click="加载当前图层_Btn_Click"
                                                        Content="加载当前图层" />
                                                    <Button
                                                        x:Name="保存图层配置"
                                                        Width="95"
                                                        Height="20"
                                                        Margin="5,5,0,0"
                                                        Background="#FFF4F5E0"
                                                        Click="保存图层配置_Btn_Click"
                                                        Content="保存图层配置" />
                                                    <Button
                                                        x:Name="加载本地图层"
                                                        Width="95"
                                                        Height="20"
                                                        Margin="5,5,0,0"
                                                        Background="AliceBlue"
                                                        Click="加载本地图层_Btn_Click"
                                                        Content="加载本地图层" />
                                                    <Button
                                                        x:Name="应用图层"
                                                        Width="95"
                                                        Height="20"
                                                        Margin="3,5,0,0"
                                                        Background="#FFF4F5E0"
                                                        Click="应用图层_Btn_Click"
                                                        Content="应用图层" />

                                                    <Button
                                                        x:Name="还原图层"
                                                        Width="95"
                                                        Height="20"
                                                        Margin="5,5,0,0"
                                                        Background="AliceBlue"
                                                        Click="还原图层_Btn_Click"
                                                        Content="还原图层" />
                                                    <Button
                                                        x:Name="图层字典"
                                                        Width="95"
                                                        Height="20"
                                                        Margin="5,5,0,0"
                                                        Background="#FFF4F5E0"
                                                        Click="图层字典_Btn_Click"
                                                        Content="图层字典" />
                                                </WrapPanel>
                                                <!-- 图层数据表 Layer Data Grid  -->
                                                <DataGrid
                                                    x:Name="LayerDataGrid"
                                                    Grid.Row="1"
                                                    Margin="0"
                                                    AutoGenerateColumns="False"
                                                    CanUserAddRows="False"
                                                    CanUserSortColumns="True"
                                                    EnableColumnVirtualization="False"
                                                    EnableRowVirtualization="False"
                                                    FrozenColumnCount="1"
                                                    GridLinesVisibility="All"
                                                    HeadersVisibility="Column"
                                                    HorizontalScrollBarVisibility="Auto"
                                                    ScrollViewer.CanContentScroll="False"
                                                    ScrollViewer.PanningMode="VerticalFirst"
                                                    VerticalScrollBarVisibility="Auto">
                                                    <DataGrid.Columns>
                                                        <DataGridCheckBoxColumn
                                                            Width="35"
                                                            Binding="{Binding ToDelete}"
                                                            Header="删除" />
                                                        <DataGridTextColumn
                                                            Width="35"
                                                            Binding="{Binding DisplayIndex}"
                                                            Header="序号"
                                                            IsReadOnly="True" />
                                                        <DataGridTextColumn
                                                            Width="100"
                                                            Binding="{Binding Name}"
                                                            Header="图层名称"
                                                            IsReadOnly="True" />
                                                        <DataGridCheckBoxColumn
                                                            Width="35"
                                                            Binding="{Binding IsOn}"
                                                            Header="开关" />
                                                        <DataGridCheckBoxColumn
                                                            Width="35"
                                                            Binding="{Binding IsFrozen}"
                                                            Header="冻结" />
                                                        <DataGridTextColumn
                                                            Width="35"
                                                            Binding="{Binding ColorIndex}"
                                                            Header="颜色"
                                                            IsReadOnly="True" />

                                                    </DataGrid.Columns>
                                                    <DataGrid.Style>
                                                        <Style TargetType="DataGrid">
                                                            <Setter Property="ColumnHeaderStyle">
                                                                <Setter.Value>
                                                                    <Style TargetType="DataGridColumnHeader">
                                                                        <Setter Property="Background" Value="#FFECECEC" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                        <Setter Property="Padding" Value="5" />
                                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                                    </Style>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </DataGrid.Style>
                                                </DataGrid>
                                                <!--  状态信息  -->
                                                <TextBlock
                                                    x:Name="statusText"
                                                    Grid.Row="2"
                                                    Margin="5"
                                                    VerticalAlignment="Center"
                                                    Text="就绪" />
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </TabItem>

                            <TabItem x:Name="工艺"                                
                                     FontWeight="Bold"
                                     Header="工艺"
                                     IsSelected="True">
                                <TabControl
                                    x:Name="MajorTabControl"
                                    Padding="1,1,1,1"
                                    FontSize="12">
                                    <TabItem x:Name="工艺图元" Header=" 工艺图元 ">
                                        <ScrollViewer x:Name="图元功能区" 
                                            Margin="0,0,0,0"
                                            FontSize="12"
                                            HorizontalScrollBarVisibility="Auto"
                                            CanContentScroll="False"
                                            VerticalScrollBarVisibility="Auto">
                                            <Grid x:Name="按键功能区" HorizontalAlignment="Left" Width="305">
                                                <Grid >
                                                    <Grid Margin="0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="85" />
                                                            <RowDefinition Height="60" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <GroupBox
                                                                x:Name="工艺表格"
                                                                Padding="0,3,0,0"
                                                                Header="工艺表格" Margin="0,5,0,0">
                                                                <WrapPanel x:Name="工艺表格按钮面板" Orientation="Horizontal" Height="55">
                                                                    <Button x:Name="生成管道表"                                                                         
                                                                            Width="90"
                                                                            Height="25"
                                                                            Margin="5,1,1,1"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Background="#FF0050A0"
                                                                            BorderBrush="#FFC2C6CE"
                                                                            Click="生成管道表_Click"
                                                                            Content="生成管道表"
                                                                            FontSize="12"
                                                                            Foreground="White" />
                                                                    <Button x:Name="生成设备表"
                                                                         Width="90"
                                                                         Height="25"
                                                                         Margin="5,1,1,1"
                                                                         HorizontalAlignment="Left"
                                                                         VerticalAlignment="Top"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Click="生成设备表_Click"
                                                                         Content="生成设备表"
                                                                         FontSize="12"
                                                                         Foreground="White" />
                                                                    <Button x:Name="插入管道表"
                                                                         Width="90"
                                                                         Height="25"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Click="插入管道表_Click"
                                                                         Content="插入管道表"
                                                                         FontSize="12"
                                                                         Foreground="White" Margin="5,1,1,1" />
                                                                    <Button x:Name="导出表格"
                                                                         Width="90"
                                                                         Height="25"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Top"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Click="导出表格_Click"
                                                                         Content="导出表格"
                                                                         FontSize="12"
                                                                         Foreground="White" Margin="5,1,1,1" />
                                                                    <Button x:Name="表格同步"
                                                                         Width="90"
                                                                         Height="25"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Click="表格同步_Click"
                                                                         Content="表格同步"
                                                                         FontSize="12"
                                                                         Foreground="White" Margin="5,1,1,1" />
                                                                    <Button x:Name="加载Excel表"
                                                                         Width="90"
                                                                         Height="25"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Background="#FF0050A0"
                                                                         BorderBrush="#FFC2C6CE"
                                                                         Click="加载Excel表_Click"
                                                                         Content="加载Excel表"
                                                                         FontSize="12"
                                                                         Foreground="White" Margin="5,1,1,1" />
                                                                </WrapPanel>
                                                            </GroupBox>
                                                        </Grid>
                                                        <Grid Grid.Row="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="214*" />
                                                            </Grid.ColumnDefinitions>
                                                            <GroupBox x:Name="工艺绘制"
                                                                Grid.ColumnSpan="2"
                                                                Margin="0,5,0,0"
                                                                Padding="0,3,0,0"
                                                                FontFamily="Microsoft YaHei UI"
                                                                Header="工艺绘制">
                                                                <WrapPanel VerticalAlignment="Center">
                                                                    <Button Width="90"
                                                                        Height="25"
                                                                        Margin="5,1,1,1"
                                                                        HorizontalAlignment="Left"
                                                                        Background="#FF0050A0"
                                                                        BorderBrush="#FFC2C6CE"
                                                                        Click="绘制进口管道_Click"
                                                                        Content="绘制进口管道"
                                                                        FontSize="12"
                                                                        Foreground="White" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                                                                    <Button x:Name="绘制出口管道"
                                                                        Width="90"
                                                                        Height="25"
                                                                        Margin="5,1,1,1"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        Background="#FF0050A0"
                                                                        BorderBrush="#FFC2C6CE"
                                                                        Click="绘制出口管道_Click"
                                                                        Content="绘制出口管道"
                                                                        FontSize="12"
                                                                        Foreground="White" VerticalContentAlignment="Center" />
                                                                    <Button x:Name="管道修改"
                                                                        Width="90"
                                                                        Height="25"
                                                                        Margin="5,1,1,1"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Background="#FF0050A0"
                                                                        BorderBrush="#FFC2C6CE"
                                                                        Click="管道修改_Click"
                                                                        Content="管道修改"
                                                                        FontSize="12"
                                                                        Foreground="White" VerticalContentAlignment="Center" />
                                                                </WrapPanel>
                                                            </GroupBox>
                                                        </Grid>
                                                        <WrapPanel
                                                            x:Name="CraftButtonsPanel"
                                                            Grid.Row="2"
                                                            Orientation="Vertical" />
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem x:Name="工艺管道计算" Header="管道计算表" >
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="60" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <WrapPanel Grid.Row="0" >
                                                <Button x:Name="重载计算表"
                                                     Width="88"
                                                     Height="24"
                                                     Margin="0,5,5,0"
                                                     Background="#FF0050A0"
                                                     BorderBrush="#FFC2C6CE"
                                                     Click="重载计算表_Click"
                                                     Content="重载计算表"
                                                     FontSize="12"
                                                     Foreground="White" 
                                                     FontFamily="Microsoft YaHei UI Light" />
                                                <Button x:Name="插入计算总表"
                                                     Width="88"
                                                     Height="24"
                                                     Margin="0,5,5,0"
                                                     Background="#FF0050A0"
                                                     BorderBrush="#FFC2C6CE"
                                                     Command="{Binding InsertTableCommand}"
                                                     Content="插入计算表"
                                                     FontSize="12"
                                                     Foreground="White" 
                                                     FontFamily="Microsoft YaHei UI Light"  />
                                                <Button x:Name="插入计算分表"
                                                        Width="88"
                                                        Height="24"
                                                        Margin="5,5,5,0"
                                                        Background="#FF0050A0"
                                                        BorderBrush="#FFC2C6CE"
                                                        Command="{Binding ExportDeviceTablesCommand}"
                                                        Content="插入计算分表"
                                                        FontSize="12"
                                                        Foreground="White"
                                                        FontFamily="Microsoft YaHei UI Light" />
                                                <Button x:Name="设备表导入"
                                                      Width="88"
                                                     Height="20"
                                                     Margin="5,5,0,0"
                                                     Click="设备表导入_Btn_Click"
                                                     Content="设备表导入"
                                                     FontFamily="Microsoft YaHei UI Light" />
                                                <Button x:Name="转换csv"
                                                     Width="88"
                                                     Height="20"
                                                     Margin="5,5,0,0"
                                                     Click="转换CSV按钮_Click"
                                                     Content="转换CSV"
                                                     FontFamily="Microsoft YaHei UI Light" />
                                                <Button x:Name="管道设备表开关"
                                                     Width="88"
                                                     Height="20"
                                                     Margin="5,5,0,0"
                                                     Click="管道设备表开关_Btn_Click"
                                                     Content="管道设备表开关"
                                                     FontFamily="Microsoft YaHei UI Light" />
                                            </WrapPanel>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible">
                                                <StackPanel x:Name="CalcDynamicHost">
                                                    <!-- 1. 脱硫系统 -->
                                                    <Expander Header="脱硫系统" IsExpanded="True">
                                                        <Grid Margin="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="145"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="60"/>
