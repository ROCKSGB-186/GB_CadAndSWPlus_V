<Window
    x:Class="GB_CadAndSWPlus_V.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="370"
    Height="300"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GB_CadAndSWPlus_V;component/DisplayPages/MainWindowStyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="5,5,5,5" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="登录" 
            Grid.Row="0"
            Margin="6,0,6,6"
            FontSize="18"
            FontWeight="Bold"
            Foreground="#0078D4"
            Text="登录" />

        <StackPanel x:Name="部门与用户名密码" 
            Grid.Row="2"
            Grid.RowSpan="2"
            Margin="4,0,4,5"
            Orientation="Vertical">
            <Separator Margin="0,1,0,8" />
            <TextBlock
                Margin="0,0,0,5"
                VerticalAlignment="Center"
                Text="注册部门：" />
            <ComboBox
                x:Name="CmbDepartments"
                Margin="0,0,0,5"
                DisplayMemberPath="DisplayName"
                SelectedValuePath="Id" />
            <TextBlock
                Margin="2,0,0,2"
                FontSize="12"
                Text="用户名：" />
            <TextBox x:Name="Login_Username" Height="26" TextChanged="Login_Username_TextChanged" />

            <TextBlock
                Margin="2,8,0,2"
                FontSize="12"
                Text="密码：" />
            <Grid Height="26">
                <PasswordBox
                    x:Name="Login_Password"
                    Height="26"
                    Padding="4,0,30,0" />
                <TextBox
                    x:Name="Login_PasswordVisible"
                    Height="26"
                    Padding="4,0,30,0"
                    TextChanged="Login_PasswordVisible_TextChanged"
                    Visibility="Collapsed" />
                <Button
                    x:Name="BtnTogglePassword"
                    Width="28"
                    Height="24"
                    Margin="0,1,1,1"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnTogglePassword_Click"
                    Content="👁"
                    FontFamily="Segoe UI Symbol"
                    FontSize="14"
                    Foreground="Gray"
                    ToolTip="显示密码" />
            </Grid>

            <StackPanel
                Width="351"
                Margin="0,5,0,5"
                Orientation="Horizontal">
                <CheckBox
                    x:Name="ChkSavePassword"
                    Margin="0,0,12,0"
                    Content="保存密码" />
                <TextBlock Width="60" Margin="200,0,0,0"><Hyperlink Click="ForgetPassword_Click">
                    <Run Text="修改密码" />
                    </Hyperlink></TextBlock>
            </StackPanel>
            <!--<TextBlock Margin="0,6,0,0" Width="65" HorizontalAlignment="Right">
                <Hyperlink Click="ForgetPassword_Click">忘记密码？</Hyperlink>
            </TextBlock>-->
        </StackPanel>

        <StackPanel x:Name="登录与取消按键" 
            Grid.Row="4"
            Grid.RowSpan="2"
            Width="230"
            Height="42"
            Margin="0,0,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="BtnCancel"
                Width="100"
                Height="30"
                Margin="6"
                Click="BtnCancel_Click"
                Content="取消" />
            <Button
                x:Name="BtnLogin"
                Width="100"
                Height="30"
                Margin="6"
                Click="BtnLogin_Click"
                Content="登录" />
        </StackPanel>

        <StackPanel x:Name="ServerSettingsPanel"
            Grid.Row="7"
            Margin="4,0,4,5"
            Visibility="Collapsed"
            Orientation="Vertical">
            <Separator Margin="0,0,0,8" />
            <TextBlock
                Margin="0,6,0,2"
                FontSize="12"
                Text="数据库类型：" />
            <ComboBox
                x:Name="CmbDatabaseType"
                Height="26"
                Margin="0,0,0,8"
                SelectionChanged="CmbDatabaseType_SelectionChanged">
                <ComboBoxItem Content="DM" />
                <ComboBoxItem Content="MYSQL" />
            </ComboBox>
            <TextBlock
                Margin="2,0,0,2"
                FontSize="12"
                Text="服务器 IP：" />
            <TextBox
                x:Name="Login_ServerIP"
                Height="26"
                Style="{StaticResource WatermarkTextBoxStyle}"
                Tag="例如：服务器 IP 或主机名" />

            <TextBlock
                Margin="2,8,0,2"
                FontSize="12"
                Text="数据库端口：" />
            <TextBox
                x:Name="Login_DataBaseserverPort"
                Height="26"
                PreviewTextInput="TxtServerPort_PreviewTextInput" />
            <TextBlock
                Margin="2,8,0,2"
                FontSize="12"
                Text="API 服务端口：" />
            <TextBox
                x:Name="Login_ApiPort"
                Height="26"
                PreviewTextInput="TxtServerPort_PreviewTextInput" />
        </StackPanel>

        <Button x:Name="BtnToggleServerSettings"
            Grid.Row="5"
            Height="22"
            Margin="4,4,0,2"
            HorizontalAlignment="Left"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            Click="BtnToggleServerSettings_Click"
            Content="显示服务器配置"
            FontSize="11"
            Foreground="#0078D4"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center" />

        <!--  状态显示：用于在代码中更新登录、保存等状态  -->
        <TextBlock
            x:Name="TxtStatus"
            Grid.Row="9"
            Margin="6,4,6,4"
            FontSize="12"
            Foreground="Gray"
            Text="状态信息"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Visibility="Collapsed" />

        <StackPanel
            x:Name="ServerActionsPanel"
            Grid.Row="11"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Visibility="Collapsed">
            <Button
                x:Name="BtnTestServer测试服务器"
                Width="100"
                Height="24"
                Margin="1,1,5,1"
                Click="BtnTestServer测试服务器_Click"
                Content="测试服务器" />
            <Button
                x:Name="BtnSaveServer"
                Width="150"
                Height="24"
                Click="BtnSaveServer_Click"
                Content="保存服务器配置" />
        </StackPanel>
    </Grid>
</Window>
