<Window x:Class="GB_CadAndSWPlus_V.DisplayPages.PipeCrossingMultiDialogWpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="管道交叉处理" Width="700" Height="450" MinWidth="600" MinHeight="400">
    <Window.Resources>
        <Style x:Key="CenterCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="检测到以下交叉点，请分别选择每个交叉点的局部上下关系："
                   FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Options}" 
          AutoGenerateColumns="False" 
          CanUserAddRows="False" CanUserDeleteRows="False"
          HeadersVisibility="Column"
          GridLinesVisibility="All"
          SelectionMode="Single" SelectionUnit="FullRow" 
            Focusable="False"
            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding Index}" 
                            Width="0.10*" ElementStyle="{StaticResource CenterCellStyle}" IsReadOnly="True"/>
                <DataGridTextColumn Header="坐标" Binding="{Binding IntersectionDisplay}" 
                            Width="0.30*" IsReadOnly="True"/>
                <DataGridTextColumn Header="管道名称" Binding="{Binding PipeName}" 
                            Width="0.25*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="处理方式" Width="0.35*" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="操作：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <RadioButton Content="相连" Margin="0,0,5,0"
                                     IsChecked="{Binding IsConnect, UpdateSourceTrigger=PropertyChanged}"/>
                                <RadioButton Content="覆盖（新管道在上）" Margin="0,0,5,0"
                                     IsChecked="{Binding IsCover, UpdateSourceTrigger=PropertyChanged}"/>
                                <RadioButton Content="下方（新管道在下）" Margin="0,0,0,0"
                                     IsChecked="{Binding IsUnder, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="管道交叉处理_确定" Content="确定" Width="80" Height="30" Margin="0,0,10,0" IsDefault="True" Click="OkButton_Click" />
            <Button x:Name="管道交叉处理_取消" Content="取消" Width="80" Height="30" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
